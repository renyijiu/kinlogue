diff --git a/internal/macos/export_darwin.go b/internal/macos/export_darwin.go
--- /dev/null
+++ b/internal/macos/export_darwin.go
@@ -0,0 +1,337 @@
+//go:build darwin
+
+package macos
+
+import (
+	"archive/zip"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"unicode/utf8"
+	"unsafe"
+
+	"github.com/ebitengine/purego/objc"
+	"golang.org/x/sys/unix"
+	"kinlogue/internal/document"
+)
+
+var ErrWrite = errors.New("export_write_failed")
+
+// Leave bounded space for ZIP headers while bounding even a malformed writer.
+const maxExportBytes int64 = document.MaxSources*document.MaxFileBytes + 1<<20
+
+// WriteExport publishes a validated ZIP at a system SavePanel selection. The
+// panel is responsible for obtaining the user's permission to replace a file.
+// The callback must only write ZIP bytes; it must not reenter macos APIs because
+// it runs inside the serialized native scope and file coordination accessor.
+func WriteExport(ctx context.Context, destination string, write func(io.Writer) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if write == nil || !validExportPath(destination) {
+		return ErrWrite
+	}
+	// Cancellation is checked before publication. native's usual late-output
+	// cancellation rule would misreport a completed atomic publication as failure.
+	err := native(context.Background(), func() error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		url := send(class("NSURL"), "fileURLWithPath:", uintptr(nsString(destination)))
+		if url == 0 {
+			return ErrWrite
+		}
+		if byte(send(url, "startAccessingSecurityScopedResource")) != 0 {
+			defer send(url, "stopAccessingSecurityScopedResource")
+		}
+		parent, err := openExportDirectory(filepath.Dir(destination))
+		if err != nil {
+			return ErrWrite
+		}
+		defer parent.Close()
+		parentInfo, err := parent.Stat()
+		if err != nil {
+			return ErrWrite
+		}
+		previous, err := exportTarget(destination)
+		if err != nil {
+			return ErrWrite
+		}
+		coordinator := send(alloc("NSFileCoordinator"), "initWithFilePresenter:", 0)
+		if coordinator == 0 {
+			return ErrWrite
+		}
+		defer release(coordinator)
+		var nsError id
+		var result error = ErrWrite
+		accessor := objc.NewBlock(func(_ objc.Block, coordinatedURL id) {
+			path, err := stringCopy(send(coordinatedURL, "path"), 1<<16)
+			if err != nil || path != destination {
+				return
+			}
+			result = writeCoordinatedExport(ctx, coordinatedURL, path, parent, parentInfo, previous, write)
+		})
+		defer accessor.Release()
+		// ForReplacing is required even when the selected destination is new.
+		send(coordinator, "coordinateWritingItemAtURL:options:error:byAccessor:", uintptr(url), 1<<3, uintptr(unsafe.Pointer(&nsError)), uintptr(accessor))
+		if nsError != 0 {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			return ErrWrite
+		}
+		return result
+	})
+	if err != nil && !errors.Is(err, context.Canceled) && !errors.Is(err, context.DeadlineExceeded) {
+		return ErrWrite
+	}
+	return err
+}
+
+func validExportPath(path string) bool {
+	return filepath.IsAbs(path) && filepath.Clean(path) == path && path != "/" &&
+		len(path) <= 1<<16 && strings.IndexByte(path, 0) < 0 && utf8.ValidString(path)
+}
+
+func openExportDirectory(path string) (*os.File, error) {
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_DIRECTORY|syscall.O_CLOEXEC|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, ErrWrite
+	}
+	return os.NewFile(uintptr(fd), ""), nil
+}
+
+func exportTarget(path string) (os.FileInfo, error) {
+	info, err := os.Lstat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil || !info.Mode().IsRegular() {
+		return nil, ErrWrite
+	}
+	return info, nil
+}
+
+func sameExportTarget(path string, previous os.FileInfo) bool {
+	current, err := exportTarget(path)
+	if err != nil {
+		return false
+	}
+	if current == nil || previous == nil {
+		return current == nil && previous == nil
+	}
+	return os.SameFile(current, previous) && current.Size() == previous.Size() && current.ModTime() == previous.ModTime()
+}
+
+func writeCoordinatedExport(ctx context.Context, destinationURL id, destination string, parent *os.File, parentInfo, previous os.FileInfo, write func(io.Writer) error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !sameExportTarget(destination, previous) {
+		return ErrWrite
+	}
+	manager := send(class("NSFileManager"), "defaultManager")
+	var nsError id
+	// The OS supplies a same-volume replacement directory with sandbox access;
+	// NSSavePanel does not grant permission to create arbitrary sibling files.
+	stagingURL := send(manager, "URLForDirectory:inDomain:appropriateForURL:create:error:", 99, 1, uintptr(destinationURL), 1, uintptr(unsafe.Pointer(&nsError)))
+	if stagingURL == 0 || nsError != 0 {
+		return ErrWrite
+	}
+	staging, err := stringCopy(send(stagingURL, "path"), 1<<16)
+	if err != nil || !validExportPath(staging) {
+		return ErrWrite
+	}
+	stagingInfo, err := os.Lstat(staging)
+	if err != nil || !stagingInfo.IsDir() || stagingInfo.Mode().Perm()&0077 != 0 {
+		return ErrWrite
+	}
+	stat, ok := stagingInfo.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Getuid()) {
+		return ErrWrite
+	}
+	// Remove only this empty OS-created directory, never recursive contents.
+	defer func() {
+		if info, err := os.Lstat(staging); err == nil && os.SameFile(info, stagingInfo) {
+			_ = os.Remove(staging)
+		}
+	}()
+	stagingDir, err := openExportDirectory(staging)
+	if err != nil {
+		return ErrWrite
+	}
+	defer stagingDir.Close()
+	openedStage, err := stagingDir.Stat()
+	if err != nil || !os.SameFile(openedStage, stagingInfo) {
+		return ErrWrite
+	}
+	file, err := os.CreateTemp(staging, "export-")
+	if err != nil {
+		return ErrWrite
+	}
+	temporary := file.Name()
+	original, err := file.Stat()
+	if err != nil {
+		_ = file.Close()
+		return ErrWrite
+	}
+	defer func() {
+		_ = file.Close()
+		if info, err := os.Lstat(temporary); err == nil && info.Mode().IsRegular() && os.SameFile(info, original) {
+			_ = os.Remove(temporary)
+		}
+	}()
+	writer := &exportWriter{ctx: ctx, file: file, remaining: maxExportBytes}
+	if err := write(writer); err != nil || writer.failed {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		return ErrWrite
+	}
+	if err := file.Sync(); err != nil {
+		return ErrWrite
+	}
+	if err := file.Close(); err != nil {
+		return ErrWrite
+	}
+	fd, err := syscall.Open(temporary, syscall.O_RDONLY|syscall.O_CLOEXEC|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return ErrWrite
+	}
+	read := os.NewFile(uintptr(fd), "")
+	defer read.Close()
+	info, err := read.Stat()
+	if err != nil || !info.Mode().IsRegular() || !os.SameFile(info, original) || info.Mode().Perm() != 0600 {
+		return ErrWrite
+	}
+	if err := validateExportZIP(ctx, read, info.Size()); err != nil {
+		return err
+	}
+	currentParent, err := os.Lstat(filepath.Dir(destination))
+	if err != nil || !currentParent.IsDir() || !os.SameFile(currentParent, parentInfo) || !sameExportTarget(destination, previous) {
+		return ErrWrite
+	}
+	currentStage, err := os.Lstat(temporary)
+	if err != nil || !currentStage.Mode().IsRegular() || !os.SameFile(currentStage, info) || currentStage.Size() != info.Size() || currentStage.ModTime() != info.ModTime() {
+		return ErrWrite
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	flags := uint32(0)
+	if previous == nil {
+		flags = unix.RENAME_EXCL
+	}
+	// Both descriptors pin the checked directories. Existing-file replacement
+	// is atomic under coordination, not CAS against uncoordinated processes.
+	if err := unix.RenameatxNp(int(stagingDir.Fd()), filepath.Base(temporary), int(parent.Fd()), filepath.Base(destination), flags); err != nil {
+		return ErrWrite
+	}
+	// Rename is the commit point. A later cancellation or directory-sync failure
+	// cannot safely roll it back; the complete, already-fsynced file is published.
+	_ = parent.Sync()
+	return nil
+}
+
+type exportWriter struct {
+	ctx       context.Context
+	file      *os.File
+	remaining int64
+	failed    bool
+}
+
+func (w *exportWriter) Write(data []byte) (int, error) {
+	if err := w.ctx.Err(); err != nil {
+		w.failed = true
+		return 0, err
+	}
+	if w.failed || int64(len(data)) > w.remaining {
+		w.failed = true
+		return 0, ErrWrite
+	}
+	n, err := w.file.Write(data)
+	w.remaining -= int64(n)
+	if err != nil || n != len(data) {
+		w.failed = true
+		return n, ErrWrite
+	}
+	return n, nil
+}
+
+func validateExportZIP(ctx context.Context, file *os.File, size int64) error {
+	if size <= 0 || size > maxExportBytes {
+		return ErrWrite
+	}
+	// Our bounded writer emits ordinary ZIP, never ZIP64 or an archive comment.
+	// Bound directory metadata before archive/zip allocates per-entry objects;
+	// checking len(archive.File) afterwards alone would not bound that allocation.
+	var end [22]byte
+	if size < int64(len(end)) {
+		return ErrWrite
+	}
+	if _, err := file.ReadAt(end[:], size-int64(len(end))); err != nil ||
+		binary.LittleEndian.Uint32(end[:]) != 0x06054b50 ||
+		binary.LittleEndian.Uint16(end[4:]) != 0 || binary.LittleEndian.Uint16(end[6:]) != 0 ||
+		binary.LittleEndian.Uint16(end[20:]) != 0 {
+		return ErrWrite
+	}
+	entries := binary.LittleEndian.Uint16(end[10:])
+	directorySize := int64(binary.LittleEndian.Uint32(end[12:]))
+	directoryOffset := int64(binary.LittleEndian.Uint32(end[16:]))
+	if entries == 0 || entries > document.MaxSources || binary.LittleEndian.Uint16(end[8:]) != entries ||
+		directorySize > 1<<20 || directoryOffset+directorySize != size-int64(len(end)) {
+		return ErrWrite
+	}
+	archive, err := zip.NewReader(file, size)
+	if err != nil || len(archive.File) == 0 || len(archive.File) > document.MaxSources {
+		return ErrWrite
+	}
+	seen := make(map[string]bool, len(archive.File))
+	var total uint64
+	for _, entry := range archive.File {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		name := entry.Name
+		if len(name) == 0 || len(name) > 255 || name == "." || name == ".." || strings.ContainsAny(name, "/\\\x00") || !utf8.ValidString(name) || seen[name] || !entry.Mode().IsRegular() || entry.UncompressedSize64 > document.MaxFileBytes {
+			return ErrWrite
+		}
+		seen[name] = true
+		total += entry.UncompressedSize64
+		if total > document.MaxSources*document.MaxFileBytes {
+			return ErrWrite
+		}
+		reader, err := entry.Open()
+		if err != nil {
+			return ErrWrite
+		}
+		// Read through EOF to verify each entry's length and CRC, bounded even if
+		// the ZIP claims a smaller length than its decompressed stream produces.
+		n, copyErr := io.Copy(io.Discard, io.LimitReader(&exportReader{ctx: ctx, reader: reader}, document.MaxFileBytes+1))
+		closeErr := reader.Close()
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if copyErr != nil || closeErr != nil || uint64(n) != entry.UncompressedSize64 {
+			return ErrWrite
+		}
+	}
+	return nil
+}
+
+type exportReader struct {
+	ctx    context.Context
+	reader io.Reader
+}
+
+func (r *exportReader) Read(data []byte) (int, error) {
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	return r.reader.Read(data)
+}
diff --git a/internal/macos/export_darwin_test.go b/internal/macos/export_darwin_test.go
--- /dev/null
+++ b/internal/macos/export_darwin_test.go
@@ -0,0 +1,301 @@
+//go:build darwin
+
+package macos
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+
+	"kinlogue/internal/document"
+)
+
+func exportZIP(t *testing.T, count int) []byte {
+	t.Helper()
+	var buffer bytes.Buffer
+	writer := zip.NewWriter(&buffer)
+	for index := range count {
+		entry, err := writer.CreateHeader(&zip.FileHeader{Name: fmt.Sprintf("source-%02d.txt", index+1), Method: zip.Store})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := io.WriteString(entry, "SYNTHETIC ORIGINAL"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buffer.Bytes()
+}
+
+func exportBytes(data []byte) func(io.Writer) error {
+	return func(w io.Writer) error { _, err := w.Write(data); return err }
+}
+
+func TestWriteExportCreatesAndReplacesCompleteZIP(t *testing.T) {
+	destination := filepath.Join(t.TempDir(), "synthetic.zip")
+	for _, count := range []int{1, 2, document.MaxSources} {
+		data := exportZIP(t, count)
+		var temporary string
+		if err := WriteExport(context.Background(), destination, func(w io.Writer) error {
+			temporary = w.(*exportWriter).file.Name()
+			return exportBytes(data)(w)
+		}); err != nil {
+			t.Fatal(err)
+		}
+		assertExportStagingRemoved(t, temporary)
+		got, err := os.ReadFile(destination)
+		if err != nil || !bytes.Equal(got, data) {
+			t.Fatal("published export differs from complete synthetic ZIP")
+		}
+		info, err := os.Stat(destination)
+		if err != nil || info.Mode().Perm() != 0600 {
+			t.Fatal("export permissions are not private")
+		}
+		entries, err := os.ReadDir(filepath.Dir(destination))
+		if err != nil || len(entries) != 1 {
+			t.Fatal("export left temporary entries")
+		}
+	}
+}
+
+func TestWriteExportFailuresPreservePreviousFile(t *testing.T) {
+	good := exportZIP(t, 1)
+	badCRC := bytes.Clone(good)
+	index := bytes.Index(badCRC, []byte("SYNTHETIC ORIGINAL"))
+	badCRC[index] ^= 1
+	oversize := bytes.Clone(good)
+	central := bytes.Index(oversize, []byte("PK\x01\x02"))
+	binary.LittleEndian.PutUint32(oversize[central+24:], uint32(document.MaxFileBytes+1))
+	oversizeDirectory := bytes.Clone(good)
+	binary.LittleEndian.PutUint32(oversizeDirectory[len(oversizeDirectory)-10:], 1<<20+1)
+	tests := []struct {
+		name  string
+		write func(io.Writer) error
+	}{
+		{"writer failure", func(w io.Writer) error { _, _ = w.Write(good); return errors.New("synthetic private detail") }},
+		{"bad CRC", exportBytes(badCRC)},
+		{"truncated", exportBytes(good[:len(good)-10])},
+		{"invalid", exportBytes([]byte("SYNTHETIC INVALID ARCHIVE"))},
+		{"empty", exportBytes(exportZIP(t, 0))},
+		{"too many sources", exportBytes(exportZIP(t, document.MaxSources+1))},
+		{"oversize header", exportBytes(oversize)},
+		{"oversize directory", exportBytes(oversizeDirectory)},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			destination := filepath.Join(t.TempDir(), "synthetic.zip")
+			if err := os.WriteFile(destination, []byte("SYNTHETIC PREVIOUS"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			var temporary string
+			err := WriteExport(context.Background(), destination, func(w io.Writer) error {
+				temporary = w.(*exportWriter).file.Name()
+				return test.write(w)
+			})
+			if !errors.Is(err, ErrWrite) || err.Error() != "export_write_failed" {
+				t.Fatalf("expected path-free export error, got %v", err)
+			}
+			assertPreviousExport(t, destination, "SYNTHETIC PREVIOUS")
+			assertExportStagingRemoved(t, temporary)
+		})
+	}
+}
+
+func TestWriteExportCancellationDoesNotPublish(t *testing.T) {
+	for _, existing := range []bool{false, true} {
+		t.Run(fmt.Sprint(existing), func(t *testing.T) {
+			destination := filepath.Join(t.TempDir(), "synthetic.zip")
+			if existing {
+				if err := os.WriteFile(destination, []byte("SYNTHETIC PREVIOUS"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			err := WriteExport(ctx, destination, func(w io.Writer) error {
+				_, err := w.Write(exportZIP(t, 1))
+				cancel()
+				return err
+			})
+			if !errors.Is(err, context.Canceled) {
+				t.Fatalf("expected cancellation, got %v", err)
+			}
+			if existing {
+				assertPreviousExport(t, destination, "SYNTHETIC PREVIOUS")
+			} else if _, err := os.Lstat(destination); !errors.Is(err, os.ErrNotExist) {
+				t.Fatal("cancelled export published")
+			}
+		})
+	}
+}
+
+func TestWriteExportRejectsUnsafeTargets(t *testing.T) {
+	for _, kind := range []string{"symlink", "fifo", "directory"} {
+		t.Run(kind, func(t *testing.T) {
+			dir := t.TempDir()
+			destination := filepath.Join(dir, "synthetic.zip")
+			switch kind {
+			case "symlink":
+				if err := os.Symlink("missing", destination); err != nil {
+					t.Fatal(err)
+				}
+			case "fifo":
+				if err := syscall.Mkfifo(destination, 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "directory":
+				if err := os.Mkdir(destination, 0700); err != nil {
+					t.Fatal(err)
+				}
+			}
+			called := false
+			err := WriteExport(context.Background(), destination, func(io.Writer) error { called = true; return nil })
+			if !errors.Is(err, ErrWrite) || called {
+				t.Fatal("unsafe destination accepted")
+			}
+		})
+	}
+	for _, destination := range []string{"relative.zip", "/", "/synthetic/../unsafe.zip", "/synthetic\x00.zip"} {
+		if err := WriteExport(context.Background(), destination, exportBytes(exportZIP(t, 1))); !errors.Is(err, ErrWrite) {
+			t.Fatal("invalid destination accepted")
+		}
+	}
+}
+
+func TestWriteExportDoesNotOverwriteConcurrentReplacement(t *testing.T) {
+	for _, existed := range []bool{false, true} {
+		t.Run(fmt.Sprint(existed), func(t *testing.T) {
+			dir := t.TempDir()
+			destination := filepath.Join(dir, "synthetic.zip")
+			if existed {
+				if err := os.WriteFile(destination, []byte("SYNTHETIC PREVIOUS"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			err := WriteExport(context.Background(), destination, func(w io.Writer) error {
+				_, err := w.Write(exportZIP(t, 1))
+				other := filepath.Join(dir, "concurrent")
+				if err := os.WriteFile(other, []byte("SYNTHETIC CONCURRENT"), 0600); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Rename(other, destination); err != nil {
+					t.Fatal(err)
+				}
+				return err
+			})
+			if !errors.Is(err, ErrWrite) {
+				t.Fatal("concurrent replacement accepted")
+			}
+			assertPreviousExport(t, destination, "SYNTHETIC CONCURRENT")
+		})
+	}
+}
+
+func TestWriteExportRejectsUnsafeZIPEntries(t *testing.T) {
+	for _, name := range []string{"../original.txt", "/original.txt", "folder/original.txt", "original\\file.txt", strings.Repeat("x", 256)} {
+		var data bytes.Buffer
+		zw := zip.NewWriter(&data)
+		entry, err := zw.Create(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, _ = io.WriteString(entry, "SYNTHETIC")
+		if err := zw.Close(); err != nil {
+			t.Fatal(err)
+		}
+		destination := filepath.Join(t.TempDir(), "synthetic.zip")
+		if err := WriteExport(context.Background(), destination, exportBytes(data.Bytes())); !errors.Is(err, ErrWrite) {
+			t.Fatal("unsafe archive entry accepted")
+		}
+	}
+}
+
+func TestWriteExportRejectsChangedParent(t *testing.T) {
+	root := t.TempDir()
+	parent := filepath.Join(root, "selected")
+	if err := os.Mkdir(parent, 0700); err != nil {
+		t.Fatal(err)
+	}
+	destination := filepath.Join(parent, "synthetic.zip")
+	if err := os.WriteFile(destination, []byte("SYNTHETIC PREVIOUS"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var temporary string
+	err := WriteExport(context.Background(), destination, func(w io.Writer) error {
+		temporary = w.(*exportWriter).file.Name()
+		if err := os.Rename(parent, filepath.Join(root, "moved")); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Mkdir(parent, 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(destination, []byte("SYNTHETIC CONCURRENT"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		return exportBytes(exportZIP(t, 1))(w)
+	})
+	if !errors.Is(err, ErrWrite) {
+		t.Fatal("changed parent was accepted")
+	}
+	assertPreviousExport(t, destination, "SYNTHETIC CONCURRENT")
+	assertPreviousExport(t, filepath.Join(root, "moved", "synthetic.zip"), "SYNTHETIC PREVIOUS")
+	assertExportStagingRemoved(t, temporary)
+}
+
+func TestExportWriterEnforcesBoundAndStickyFailure(t *testing.T) {
+	file, err := os.CreateTemp(t.TempDir(), "synthetic-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	w := &exportWriter{ctx: context.Background(), file: file, remaining: 2}
+	if n, err := w.Write([]byte("AB")); err != nil || n != 2 {
+		t.Fatal("exact bound was rejected")
+	}
+	if n, err := w.Write([]byte("C")); !errors.Is(err, ErrWrite) || n != 0 {
+		t.Fatal("overflow was accepted")
+	}
+	if _, err := w.Write(nil); !errors.Is(err, ErrWrite) {
+		t.Fatal("overflow was forgotten")
+	}
+	info, err := file.Stat()
+	if err != nil || info.Size() != 2 {
+		t.Fatal("writer exceeded bound")
+	}
+}
+
+func assertExportStagingRemoved(t *testing.T, temporary string) {
+	t.Helper()
+	if temporary == "" {
+		t.Fatal("writer never received staging file")
+	}
+	if _, err := os.Lstat(temporary); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("temporary file remains")
+	}
+	if _, err := os.Lstat(filepath.Dir(temporary)); !errors.Is(err, os.ErrNotExist) {
+		t.Fatal("temporary directory remains")
+	}
+}
+
+func assertPreviousExport(t *testing.T, destination, previous string) {
+	t.Helper()
+	got, err := os.ReadFile(destination)
+	if err != nil || string(got) != previous {
+		t.Fatal("previous export changed")
+	}
+	entries, err := os.ReadDir(filepath.Dir(destination))
+	if err != nil || len(entries) != 1 {
+		t.Fatal("temporary export entries remain")
+	}
+}
