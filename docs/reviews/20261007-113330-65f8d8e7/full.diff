+		if err := os.Mkdir(path, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := filepath.Join(f.root, "library.sqlite")
+	if err := os.WriteFile(path, nil, 0600); err != nil {
+		t.Fatal(err)
