+func finishSources(t *testing.T, s *Store, r Report) Report {
+	t.Helper()
+	for _, source := range r.Sources {
+		var err error
+		r, err = s.SaveSourceExtraction(ctx, r.ID, source.ID, extraction())
+		if err != nil {
+			t.Fatal(err)
