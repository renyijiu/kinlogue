+	service := app.New(store, nativeProcessor{}, macos.ReadImportedFile, macos.WriteExport)
+	defer service.Close()
+	r, err := service.ImportMany(ctx, paths)
+	if err != nil || r.Status != "review" || len(r.Sources) != 2 {
+		t.Fatalf("native group: %v", err)
+	}
