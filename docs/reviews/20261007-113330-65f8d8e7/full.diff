diff --git a/internal/app/daily_test.go b/internal/app/daily_test.go
--- /dev/null
+++ b/internal/app/daily_test.go
@@ -0,0 +1,139 @@
+package app
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"kinlogue/internal/document"
+	"kinlogue/internal/library"
+)
+
+func TestGroupedImportRetryKeepsSuccessfulSourceAndLocalPages(t *testing.T) {
+	ctx := context.Background()
+	calls := map[string]int{}
+	a, _ := newTestService(t, processor{func(_ context.Context, data []byte) (document.Extraction, error) {
+		name := string(data)
+		calls[name]++
+		if name == "second.pdf" && calls[name] == 1 {
+			return document.Extraction{}, document.ErrUnavailable
+		}
+		e := synthetic()
+		e.Blocks[0].Text = name
+		return e, nil
+	}})
+	a.readFile = func(path string) ([]byte, error) { return []byte(filepath.Base(path)), nil }
+	r, err := a.ImportMany(ctx, []string{"/synthetic/first.pdf", "/synthetic/second.pdf"})
+	if !errors.Is(err, document.ErrUnavailable) || r.Status != "failed" || len(r.Sources) != 2 {
+		t.Fatalf("grouped failure not recoverable: %v", err)
+	}
+	if r.Sources[0].Extraction.Text() != "first.pdf" || r.Sources[1].Extraction.Engine != "" {
+		t.Fatal("partial source outcome lost or published as success")
+	}
+	if _, err := a.Preview(ctx, r.ID, r.Sources[1].ID, 1); err != nil {
+		t.Fatal("failed source original should remain inspectable")
+	}
+	r, err = a.Retry(ctx, r.ID)
+	if err != nil || r.Status != "review" || calls["first.pdf"] != 1 || calls["second.pdf"] != 2 {
+		t.Fatal("retry repeated successful OCR or failed to complete")
+	}
+	if r.Review.Text != "first.pdf\nsecond.pdf" || r.Sources[0].Extraction.Blocks[0].Page != 1 || r.Sources[1].Extraction.Blocks[0].Page != 1 {
+		t.Fatal("report text or source-local page provenance changed")
+	}
+	if _, err := a.Preview(ctx, r.ID, "other-source", 1); !errors.Is(err, library.ErrNotFound) {
+		t.Fatal("preview accepted an unrelated source")
+	}
+}
+
+func TestConfirmedCorrectionExportAndDeleteUseActualStoredOriginals(t *testing.T) {
+	ctx := context.Background()
+	a, _ := newTestService(t, processor{func(_ context.Context, data []byte) (document.Extraction, error) {
+		e := synthetic()
+		e.Blocks[0].Text = string(data)
+		return e, nil
+	}})
+	a.readFile = func(path string) ([]byte, error) { return []byte(filepath.Base(path)), nil }
+	var archive bytes.Buffer
+	writeCalls := 0
+	a.writeExport = func(c context.Context, path string, write func(io.Writer) error) error {
+		writeCalls++
+		return write(&archive)
+	}
+	r, err := a.ImportMany(ctx, []string{"/synthetic/one.pdf", "/synthetic/two.pdf"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := a.ExportOriginals(ctx, r.ID, "/synthetic/output.zip"); !errors.Is(err, library.ErrState) || writeCalls != 0 {
+		t.Fatal("draft export reached publication")
+	}
+	m, _ := a.AddMember(ctx, "Synthetic A")
+	other, _ := a.AddMember(ctx, "Synthetic B")
+	e := r.Review
+	e.MemberID, e.Title, e.Text = m.ID, "Synthetic report", "旧修正"
+	r, err = a.Confirm(ctx, r.ID, e)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw := append([]library.Source(nil), r.Sources...)
+	e = r.Review
+	e.SourceIDs = []string{r.Sources[1].ID, r.Sources[0].ID}
+	e.MemberID, e.Text, e.Notes = other.ID, "新修正", "Private synthetic note excluded from ZIP"
+	if rows, _ := a.Search(ctx, m.ID, "旧修正"); len(rows) != 1 {
+		t.Fatal("local edits changed saved content")
+	}
+	r, err = a.UpdateConfirmed(ctx, r.ID, e)
+	if err != nil || r.Status != "confirmed" || !r.Review.Equal(e) {
+		t.Fatal("confirmed edit did not commit")
+	}
+	if !reflect.DeepEqual(r.Sources[0], raw[1]) || !reflect.DeepEqual(r.Sources[1], raw[0]) {
+		t.Fatal("reorder changed original recognition")
+	}
+	if rows, _ := a.Search(ctx, m.ID, ""); len(rows) != 0 {
+		t.Fatal("old member still sees moved record")
+	}
+	if rows, _ := a.Search(ctx, other.ID, "新修正"); len(rows) != 1 {
+		t.Fatal("new member cannot search correction")
+	}
+	if err := a.ExportOriginals(ctx, r.ID, "/synthetic/output.zip"); err != nil {
+		t.Fatal(err)
+	}
+	z, err := zip.NewReader(bytes.NewReader(archive.Bytes()), int64(archive.Len()))
+	if err != nil || len(z.File) != 2 {
+		t.Fatal("invalid original-only ZIP")
+	}
+	for i, want := range []string{"two.pdf", "one.pdf"} {
+		f, err := z.File[i].Open()
+		if err != nil {
+			t.Fatal(err)
+		}
+		data, err := io.ReadAll(f)
+		_ = f.Close()
+		if err != nil || string(data) != want {
+			t.Fatal("ZIP did not preserve source order and bytes")
+		}
+		if z.File[i].Name != []string{"001.pdf", "002.pdf"}[i] {
+			t.Fatal("ZIP exposed a display name or unsafe path")
+		}
+	}
+	deleted, err := a.DeleteReport(ctx, r.ID)
+	if err != nil || deleted.CleanupPending {
+		t.Fatal("deletion did not finish owned source cleanup")
+	}
+	if _, err := a.Get(ctx, r.ID); !errors.Is(err, library.ErrNotFound) {
+		t.Fatal("deleted record remains visible")
+	}
+}
+
+func TestGroupedImportRejectsSourceCountBeforeReading(t *testing.T) {
+	a, _ := newTestService(t, processor{func(context.Context, []byte) (document.Extraction, error) { return synthetic(), nil }})
+	reads := 0
+	a.readFile = func(string) ([]byte, error) { reads++; return nil, nil }
+	if _, err := a.ImportMany(context.Background(), make([]string, document.MaxSources+1)); !errors.Is(err, document.ErrLimit) || reads != 0 {
+		t.Fatal("source budget did not reject before file access")
+	}
+}
diff --git a/internal/app/export.go b/internal/app/export.go
--- /dev/null
+++ b/internal/app/export.go
@@ -0,0 +1,83 @@
+package app
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+
+	"kinlogue/internal/library"
+)
+
+var ErrExport = errors.New("original_export_failed")
+
+// ExportOriginals holds mutation admission for one confirmed snapshot. The
+// injected platform writer owns the selected-file authorization, ZIP integrity
+// check and atomic publication; it must not call a native recognizer itself.
+func (s *Service) ExportOriginals(ctx context.Context, id, destination string) error {
+	_, err := command(s, ctx, true, func(c context.Context) (struct{}, error) {
+		r, err := s.store.Get(c, id)
+		if err != nil {
+			return struct{}{}, err
+		}
+		if r.Status != "confirmed" {
+			return struct{}{}, library.ErrState
+		}
+		if s.writeExport == nil {
+			return struct{}{}, ErrExport
+		}
+		err = s.writeExport(c, destination, func(output io.Writer) error {
+			archive := zip.NewWriter(output)
+			for index, source := range r.Sources {
+				if err := c.Err(); err != nil {
+					return err
+				}
+				data, err := s.store.ReadOriginal(c, id, source.ID)
+				if err != nil {
+					return err
+				}
+				extension := map[string]string{"pdf": "pdf", "jpeg": "jpg", "png": "png", "heic": "heic", "tiff": "tiff"}[source.Extraction.Kind]
+				if extension == "" {
+					return library.ErrCorrupt
+				}
+				header := &zip.FileHeader{Name: fmt.Sprintf("%03d.%s", index+1, extension), Method: zip.Store}
+				header.SetMode(0600)
+				entry, err := archive.CreateHeader(header)
+				if err != nil {
+					return err
+				}
+				if _, err = io.Copy(entry, exportReader{c, bytes.NewReader(data)}); err != nil {
+					return err
+				}
+			}
+			if err := c.Err(); err != nil {
+				return err
+			}
+			return archive.Close()
+		})
+		// A nil platform result means publication committed, even if shutdown
+		// arrived just afterwards. Never report cancellation after that commit.
+		if err != nil {
+			if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+				return struct{}{}, err
+			}
+			return struct{}{}, ErrExport
+		}
+		return struct{}{}, nil
+	})
+	return err
+}
+
+type exportReader struct {
+	ctx    context.Context
+	reader io.Reader
+}
+
+func (r exportReader) Read(p []byte) (int, error) {
+	if err := r.ctx.Err(); err != nil {
+		return 0, err
+	}
+	return r.reader.Read(p)
+}
diff --git a/internal/app/export_test.go b/internal/app/export_test.go
--- /dev/null
+++ b/internal/app/export_test.go
@@ -0,0 +1,136 @@
+package app
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"kinlogue/internal/document"
+	"kinlogue/internal/library"
+)
+
+func exportFixture(t *testing.T) (*Service, *library.Store, library.Report) {
+	t.Helper()
+	a, store := newTestService(t, processor{func(context.Context, []byte) (document.Extraction, error) { return synthetic(), nil }})
+	ctx := context.Background()
+	r, err := a.Import(ctx, "/synthetic/input.pdf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	m, err := a.AddMember(ctx, "Synthetic export member")
+	if err != nil {
+		t.Fatal(err)
+	}
+	e := r.Review
+	e.MemberID, e.Title = m.ID, "Synthetic export report"
+	r, err = a.Confirm(ctx, r.ID, e)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return a, store, r
+}
+
+func awaitExport(t *testing.T, result <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-result:
+		return err
+	case <-time.After(3 * time.Second):
+		t.Fatal("synthetic export did not settle")
+		return nil
+	}
+}
+
+func TestExportHoldsMutationAdmissionUntilPublication(t *testing.T) {
+	a, _, r := exportFixture(t)
+	entered, release := make(chan struct{}), make(chan struct{})
+	defer func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	}()
+	a.writeExport = func(ctx context.Context, _ string, write func(io.Writer) error) error {
+		close(entered)
+		<-release
+		return write(io.Discard)
+	}
+	done := make(chan error, 1)
+	go func() { done <- a.ExportOriginals(context.Background(), r.ID, "/synthetic/output.zip") }()
+	<-entered
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	if _, err := a.DeleteReport(ctx, r.ID); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatal("queued deletion did not cancel")
+	}
+	if _, err := a.Get(context.Background(), r.ID); err != nil {
+		t.Fatal("cancelled deletion changed the export snapshot")
+	}
+	close(release)
+	if err := awaitExport(t, done); err != nil {
+		t.Fatal(err)
+	}
+	if result, err := a.DeleteReport(context.Background(), r.ID); err != nil || result.CleanupPending {
+		t.Fatal("mutation admission did not reopen after export")
+	}
+}
+
+func TestCloseCancelsExportAndWaitsBeforeClosingStore(t *testing.T) {
+	a, store, r := exportFixture(t)
+	entered, cancelled, release := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	defer func() {
+		select {
+		case <-release:
+		default:
+			close(release)
+		}
+	}()
+	a.writeExport = func(ctx context.Context, _ string, _ func(io.Writer) error) error {
+		close(entered)
+		<-ctx.Done()
+		close(cancelled)
+		<-release
+		return ctx.Err()
+	}
+	done, closed := make(chan error, 1), make(chan error, 1)
+	go func() { done <- a.ExportOriginals(context.Background(), r.ID, "/synthetic/output.zip") }()
+	<-entered
+	go func() { closed <- a.Close() }()
+	<-cancelled
+	select {
+	case <-closed:
+		t.Fatal("Close returned while platform publication remained entered")
+	default:
+	}
+	if _, err := store.Get(context.Background(), r.ID); err != nil {
+		t.Fatal("Store closed before platform callback settled")
+	}
+	close(release)
+	if err := awaitExport(t, done); !errors.Is(err, context.Canceled) {
+		t.Fatal("unpublished export did not report cancellation")
+	}
+	if err := awaitExport(t, closed); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestExportDoesNotMisreportCancellationAfterPublication(t *testing.T) {
+	a, _, r := exportFixture(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var archive bytes.Buffer
+	a.writeExport = func(_ context.Context, _ string, write func(io.Writer) error) error {
+		if err := write(&archive); err != nil {
+			return err
+		}
+		cancel() // The platform has already committed the complete ZIP.
+		return nil
+	}
+	if err := a.ExportOriginals(ctx, r.ID, "/synthetic/output.zip"); err != nil || archive.Len() == 0 {
+		t.Fatal("successful publication was misreported as cancellation")
+	}
+}
