+func multiDraft(t *testing.T, s *Store) Report {
+	t.Helper()
+	r, err := s.CreateDraftSources(ctx, []string{"synthetic-a.pdf", "../../synthetic-b.png"}, func(i int) ([]byte, error) { return []byte{byte(i + 1)}, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
