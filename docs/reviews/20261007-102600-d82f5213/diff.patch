+package document
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestExtractionValidation(t *testing.T) {
+	good := Extraction{PageCount: 1, Engine: "synthetic", Blocks: []Block{{Page: 1, Text: "Synthetic report", Bounds: Rect{Width: 1, Height: 1}, Confidence: 1, Method: "text-layer"}}}
+	if err := good.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	bad := good
+	bad.Blocks = append([]Block(nil), good.Blocks...)
+	bad.Blocks[0].Page = 2
+	if err := bad.Validate(); err == nil {
+		t.Fatal("accepted a nonexistent source page")
+	}
+	bad.Blocks[0] = good.Blocks[0]
+	bad.Blocks[0].Text = strings.Repeat("x", MaxBlockBytes+1)
+	if err := bad.Validate(); err == nil {
+		t.Fatal("accepted oversized transcription")
+	}
+}
+
+func TestDateMustBeExplicitAndValid(t *testing.T) {
+	for _, value := range []string{"", "2024-02-29", "2026-10-07"} {
+		if err := ValidateDate(value); err != nil {
+			t.Fatalf("valid date rejected: %v", err)
+		}
+	}
+	for _, value := range []string{"2025-02-29", "2026-02-30", "tomorrow", "2026-1-2"} {
+		if err := ValidateDate(value); err == nil {
+			t.Fatal("invalid date accepted")
+		}
+	}
+}
diff --git a/internal/library/store.go b/internal/library/store.go
new file mode 100644
index 0000000..a4a7203
--- /dev/null
+++ b/internal/library/store.go
@@ -0,0 +1,726 @@
+// Package library owns the new, isolated Go library format. Original bytes and
+// OCR are immutable; only explicitly confirmed corrections are searchable.
+package library
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+	"unicode/utf8"
+
+	"kinlogue/internal/document"
+	_ "modernc.org/sqlite"
+)
+
+var (
+	ErrInvalid     = errors.New("library_invalid")
+	ErrState       = errors.New("library_invalid_state")
+	ErrNotFound    = errors.New("library_not_found")
+	ErrCorrupt     = errors.New("library_damaged")
+	ErrLocked      = errors.New("library_in_use")
+	ErrUnsupported = errors.New("library_unsupported_format")
+	ErrStorage     = errors.New("library_storage_failed")
+	ErrClosed      = errors.New("library_closed")
+)
+
+type Member struct{ ID, Name string }
+type Edit struct{ MemberID, Title, Date, Text, Notes string }
+type Report struct {
+	ID, FileName, Status string
+	Review               Edit
+	Extraction           document.Extraction
+	CreatedAt            string
+	Failure              string
+}
+
+// Store is a single owner of a private library directory. Methods serialize
+// lifecycle and writes; the advisory lock also excludes other app processes.
+type Store struct {
+	mu               sync.Mutex
+	db               *sql.DB
+	root             *os.Root
+	originals        *os.Root
+	lock             *os.File
+	path             string
+	identity         os.FileInfo
+	originalIdentity os.FileInfo
+	databaseIdentity os.FileInfo
+	lockIdentity     os.FileInfo
+}
+
+const schema = `
+CREATE TABLE members (id TEXT PRIMARY KEY, name TEXT NOT NULL);
+CREATE TABLE reports (
+ id TEXT PRIMARY KEY, file_name TEXT NOT NULL, status TEXT NOT NULL CHECK(status IN ('processing','review','failed','confirmed')),
+ member_id TEXT REFERENCES members(id), title TEXT NOT NULL DEFAULT '', report_date TEXT NOT NULL DEFAULT '',
+ corrected_text TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '', extraction TEXT NOT NULL DEFAULT '',
+ created_at TEXT NOT NULL, failure TEXT NOT NULL DEFAULT '', digest TEXT NOT NULL, byte_count INTEGER NOT NULL CHECK(byte_count > 0)
+);
+CREATE INDEX reports_member_date ON reports(member_id, status, report_date);
+CREATE TABLE settings (key TEXT PRIMARY KEY, value TEXT NOT NULL);
+INSERT INTO settings VALUES ('language', 'system');
+PRAGMA application_id=1263290191;
+PRAGMA user_version=1;`
+
+func Open(path string) (_ *Store, err error) {
+	path, err = filepath.Abs(path)
+	if err != nil {
+		return nil, ErrInvalid
+	}
+	if info, e := os.Lstat(path); e == nil && info.Mode()&os.ModeSymlink != 0 {
+		return nil, ErrCorrupt
+	}
+	// Resolve system aliases such as /var once, but never accept a symlink at
+	// the library root itself. The caller supplies an existing trusted parent.
+	parent, e := filepath.EvalSymlinks(filepath.Dir(path))
+	if e != nil {
+		return nil, ErrStorage
+	}
+	path = filepath.Join(parent, filepath.Base(path))
+	if e = os.Mkdir(path, 0700); e != nil && !errors.Is(e, os.ErrExist) {
+		return nil, ErrStorage
+	}
+	info, e := os.Lstat(path)
+	if e != nil || !private(info, true) {
+		return nil, ErrCorrupt
+	}
+	r, e := os.OpenRoot(path)
+	if e != nil {
+		return nil, ErrCorrupt
+	}
+	s := &Store{root: r, path: path, identity: info}
+	defer func() {
+		if err != nil {
+			_ = s.Close()
+		}
+	}()
+	if e = s.checkRoot(); e != nil {
+		return nil, e
+	}
+	entries, e := os.ReadDir(path)
+	if e != nil {
+		return nil, ErrStorage
+	}
+	databaseExists := false
+	for _, entry := range entries {
+		name := entry.Name()
+		if name != ".owner.lock" && name != "originals" && name != "library.sqlite" && name != "library.sqlite-journal" {
+			return nil, ErrUnsupported
+		}
+		fi, e := r.Lstat(name)
+		if e != nil || !private(fi, name == "originals") {
+			return nil, ErrCorrupt
+		}
+		if name == "library.sqlite" {
+			databaseExists = true
+		}
+	}
+	s.lock, e = r.OpenFile(".owner.lock", os.O_CREATE|os.O_RDWR|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0600)
+	if e != nil {
+		return nil, ErrCorrupt
+	}
+	if fi, e := s.lock.Stat(); e != nil || !private(fi, false) {
+		return nil, ErrCorrupt
+	} else {
+		s.lockIdentity = fi
+	}
+	if e = syscall.Flock(int(s.lock.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); e != nil {
+		return nil, ErrLocked
+	}
+	if e = r.Mkdir("originals", 0700); e != nil && !errors.Is(e, os.ErrExist) {
+		return nil, ErrStorage
+	}
+	s.originalIdentity, e = r.Lstat("originals")
+	if e != nil || !private(s.originalIdentity, true) {
+		return nil, ErrCorrupt
+	}
+	s.originals, e = r.OpenRoot("originals")
+	if e != nil {
+		return nil, ErrCorrupt
+	}
+	if opened, e := s.originals.Stat("."); e != nil || !os.SameFile(opened, s.originalIdentity) {
+		return nil, ErrCorrupt
+	}
+	if !databaseExists {
+		originals, e := os.ReadDir(filepath.Join(path, "originals"))
+		if e != nil || len(originals) != 0 {
+			return nil, ErrCorrupt
+		}
+		f, e := r.OpenFile("library.sqlite", os.O_CREATE|os.O_EXCL|os.O_RDWR|syscall.O_NOFOLLOW, 0600)
+		if e != nil {
+			return nil, ErrStorage
+		}
+		if e = f.Close(); e != nil {
+			return nil, ErrStorage
+		}
+	}
+	s.databaseIdentity, e = r.Lstat("library.sqlite")
+	if e != nil || !private(s.databaseIdentity, false) {
+		return nil, ErrCorrupt
+	}
+	if e = s.checkRoot(); e != nil {
+		return nil, e
+	}
+	s.db, e = sql.Open("sqlite", filepath.Join(path, "library.sqlite"))
+	if e != nil {
+		return nil, ErrStorage
+	}
+	s.db.SetMaxOpenConns(1)
+	if _, e = s.db.Exec("PRAGMA foreign_keys=ON; PRAGMA busy_timeout=1000; PRAGMA trusted_schema=OFF;"); e != nil {
+		return nil, ErrCorrupt
+	}
+	if databaseExists {
+		var version, application int
+		if e = s.db.QueryRow("PRAGMA user_version").Scan(&version); e != nil {
+			return nil, ErrCorrupt
+		}
+		if e = s.db.QueryRow("PRAGMA application_id").Scan(&application); e != nil {
+			return nil, ErrCorrupt
+		}
+		if version != 1 || application != 1263290191 {
+			return nil, ErrUnsupported
+		}
+		var check string
+		if e = s.db.QueryRow("PRAGMA quick_check").Scan(&check); e != nil || check != "ok" {
+			return nil, ErrCorrupt
+		}
+	}
+	if _, e = s.db.Exec("PRAGMA journal_mode=DELETE; PRAGMA synchronous=EXTRA;"); e != nil {
+		return nil, ErrCorrupt
+	}
+	if !databaseExists {
+		tx, e := s.db.Begin()
+		if e != nil {
+			return nil, ErrStorage
+		}
+		if _, e = tx.Exec(schema); e != nil {
+			_ = tx.Rollback()
+			return nil, ErrStorage
+		}
+		if e = tx.Commit(); e != nil {
+			return nil, ErrStorage
+		}
+	}
+	// Recovery changes state only; it never restarts recognition.
+	if _, e = s.db.Exec("UPDATE reports SET status='failed', failure='interrupted' WHERE status='processing'"); e != nil {
+		return nil, ErrCorrupt
+	}
+	return s, nil
+}
+
+func private(info os.FileInfo, directory bool) bool {
+	if info == nil || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
+		return false
+	}
+	if directory && !info.IsDir() || !directory && !info.Mode().IsRegular() {
+		return false
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	return ok && stat.Uid == uint32(os.Getuid()) && (directory || stat.Nlink == 1)
+}
+
+func (s *Store) checkRoot() error {
+	info, err := os.Lstat(s.path)
+	if err != nil || !private(info, true) || !os.SameFile(info, s.identity) {
+		return ErrCorrupt
+	}
+	openedRoot, err := s.root.Stat(".")
+	if err != nil || !os.SameFile(openedRoot, s.identity) {
+		return ErrCorrupt
+	}
+	if s.originalIdentity != nil {
+		info, err = s.root.Lstat("originals")
+		if err != nil || !private(info, true) || !os.SameFile(info, s.originalIdentity) {
+			return ErrCorrupt
+		}
+	}
+	for name, identity := range map[string]os.FileInfo{"library.sqlite": s.databaseIdentity, ".owner.lock": s.lockIdentity} {
+		if identity == nil {
+			continue
+		}
+		info, err = s.root.Lstat(name)
+		if err != nil || !private(info, false) || !os.SameFile(info, identity) {
+			return ErrCorrupt
+		}
+	}
+	if journal, err := s.root.Lstat("library.sqlite-journal"); err == nil {
+		if !private(journal, false) {
+			return ErrCorrupt
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return ErrCorrupt
+	}
+	return nil
+}
+
+func (s *Store) begin(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if s.db == nil {
+		return ErrClosed
+	}
+	return s.checkRoot()
+}
+
+func (s *Store) Close() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var result error
+	if s.db != nil {
+		if s.db.Close() != nil {
+			result = ErrStorage
+		}
+		s.db = nil
+	}
+	if s.root != nil {
+		if s.root.Close() != nil {
+			result = ErrStorage
+		}
+		s.root = nil
+	}
+	if s.originals != nil {
+		if s.originals.Close() != nil {
+			result = ErrStorage
+		}
+		s.originals = nil
+	}
+	if s.lock != nil {
+		if s.lock.Close() != nil {
+			result = ErrStorage
+		}
+		s.lock = nil
+	}
+	return result
+}
+
+func opaqueID() string    { return hex.EncodeToString(randomBytes()) }
+func randomBytes() []byte { b := make([]byte, 16); _, _ = rand.Read(b); return b }
+func validID(id string) bool {
+	b, e := hex.DecodeString(id)
+	return e == nil && len(b) == 16 && id == strings.ToLower(id)
+}
+func bounded(s string, max int) bool {
+	return utf8.ValidString(s) && len(s) <= max && !strings.ContainsRune(s, 0)
+}
+func storageError(ctx context.Context, err error) error {
+	if err == nil {
+		return nil
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if errors.Is(err, sql.ErrNoRows) {
+		return ErrNotFound
+	}
+	return ErrStorage
+}
+
+func (s *Store) AddMember(ctx context.Context, name string) (Member, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return Member{}, err
+	}
+	name = strings.TrimSpace(name)
+	if name == "" || !bounded(name, 256) {
+		return Member{}, ErrInvalid
+	}
+	m := Member{ID: opaqueID(), Name: name}
+	_, err := s.db.ExecContext(ctx, "INSERT INTO members(id,name) VALUES (?,?)", m.ID, m.Name)
+	return m, storageError(ctx, err)
+}
+
+func (s *Store) Members(ctx context.Context) ([]Member, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return nil, err
+	}
+	rows, err := s.db.QueryContext(ctx, "SELECT id,name FROM members ORDER BY name,id")
+	if err != nil {
+		return nil, storageError(ctx, err)
+	}
+	defer rows.Close()
+	result := []Member{}
+	for rows.Next() {
+		var m Member
+		if err := rows.Scan(&m.ID, &m.Name); err != nil {
+			return nil, ErrCorrupt
+		}
+		result = append(result, m)
+	}
+	return result, storageError(ctx, rows.Err())
+}
+
+func (s *Store) CreateDraft(ctx context.Context, displayName string, data []byte) (Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return Report{}, err
+	}
+	if len(data) == 0 || len(data) > document.MaxFileBytes || !bounded(displayName, 1024) || strings.TrimSpace(displayName) == "" {
+		return Report{}, ErrInvalid
+	}
+	r := Report{ID: opaqueID(), FileName: displayName, Status: "processing", CreatedAt: time.Now().UTC().Format(time.RFC3339Nano)}
+	if err := s.writeOriginal(ctx, r.ID, data); err != nil {
+		return Report{}, err
+	}
+	if err := s.checkRoot(); err != nil {
+		return Report{}, err
+	}
+	digest := sha256.Sum256(data)
+	_, err := s.db.ExecContext(ctx, "INSERT INTO reports(id,file_name,status,created_at,digest,byte_count) VALUES (?,?,?,?,?,?)", r.ID, r.FileName, r.Status, r.CreatedAt, hex.EncodeToString(digest[:]), len(data))
+	// A failed DB commit may retain an unreferenced blob. It is never exposed
+	// as a report and is deliberately not reclaimed by startup or deletion.
+	if err != nil {
+		return Report{}, storageError(ctx, err)
+	}
+	return r, nil
+}
+
+func (s *Store) writeOriginal(ctx context.Context, id string, data []byte) error {
+	part, leaf := id+".part", id+".blob"
+	f, err := s.originals.OpenFile(part, os.O_CREATE|os.O_EXCL|os.O_WRONLY|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return ErrStorage
+	}
+	_, err = f.Write(data)
+	if err == nil {
+		err = f.Sync()
+	}
+	if closeErr := f.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return ErrStorage
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	// Link publishes a complete file without replacing an existing object.
+	if err = s.originals.Link(part, leaf); err != nil {
+		return ErrStorage
+	}
+	if err = s.originals.Remove(part); err != nil {
+		return ErrStorage
+	}
+	dir, err := s.originals.OpenFile(".", os.O_RDONLY|syscall.O_DIRECTORY|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return ErrCorrupt
+	}
+	err = dir.Sync()
+	_ = dir.Close()
+	if err != nil {
+		return ErrStorage
+	}
+	return nil
+}
+
+const reportColumns = "id,file_name,status,COALESCE(member_id,''),title,report_date,corrected_text,notes,extraction,created_at,failure"
+
+type scanner interface{ Scan(...any) error }
+
+func scanReport(row scanner) (Report, error) {
+	var r Report
+	var raw string
+	err := row.Scan(&r.ID, &r.FileName, &r.Status, &r.Review.MemberID, &r.Review.Title, &r.Review.Date, &r.Review.Text, &r.Review.Notes, &raw, &r.CreatedAt, &r.Failure)
+	if err != nil {
+		return Report{}, err
+	}
+	if raw != "" {
+		if len(raw) > 2*document.MaxTextBytes || json.Unmarshal([]byte(raw), &r.Extraction) != nil || r.Extraction.Validate() != nil {
+			return Report{}, ErrCorrupt
+		}
+	}
+	if !validID(r.ID) || (r.Status == "review" || r.Status == "confirmed") && raw == "" {
+		return Report{}, ErrCorrupt
+	}
+	return r, nil
+}
+
+func (s *Store) get(ctx context.Context, id string) (Report, error) {
+	if !validID(id) {
+		return Report{}, ErrNotFound
+	}
+	r, err := scanReport(s.db.QueryRowContext(ctx, "SELECT "+reportColumns+" FROM reports WHERE id=?", id))
+	if errors.Is(err, ErrCorrupt) {
+		return Report{}, err
+	}
+	return r, storageError(ctx, err)
+}
+
+func (s *Store) Get(ctx context.Context, id string) (Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return Report{}, err
+	}
+	return s.get(ctx, id)
+}
+
+func validExtraction(e document.Extraction) bool {
+	if e.Validate() != nil || !bounded(e.Engine, 128) || len(e.Text()) > document.MaxTextBytes {
+		return false
+	}
+	switch e.Kind {
+	case "pdf", "jpeg", "png", "heic", "tiff":
+	default:
+		return false
+	}
+	for _, block := range e.Blocks {
+		if !bounded(block.Method, 64) {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *Store) SaveExtraction(ctx context.Context, id string, e document.Extraction) (Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return Report{}, err
+	}
+	if !validExtraction(e) {
+		return Report{}, ErrInvalid
+	}
+	r, err := s.get(ctx, id)
+	if err != nil {
+		return Report{}, err
+	}
+	if r.Status != "processing" && r.Status != "failed" || r.Extraction.Engine != "" {
+		return Report{}, ErrState
+	}
+	raw, err := json.Marshal(e)
+	if err != nil || len(raw) > 2*document.MaxTextBytes {
+		return Report{}, ErrInvalid
+	}
+	_, err = s.db.ExecContext(ctx, "UPDATE reports SET extraction=?,corrected_text=?,status='review',failure='' WHERE id=?", string(raw), e.Text(), id)
+	if err != nil {
+		return Report{}, storageError(ctx, err)
+	}
+	return s.get(ctx, id)
+}
+
+func (s *Store) FailDraft(ctx context.Context, id, code string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return err
+	}
+	// This is an enum, not an error-message sink: paths/content never persist.
+	switch code {
+	case "interrupted", "recognition_failed", "unsupported", "invalid", "limit", "locked", "unavailable", "cancelled":
+	default:
+		return ErrInvalid
+	}
+	r, err := s.get(ctx, id)
+	if err != nil {
+		return err
+	}
+	if r.Status != "processing" && r.Status != "failed" {
+		return ErrState
+	}
+	_, err = s.db.ExecContext(ctx, "UPDATE reports SET status='failed',failure=? WHERE id=?", code, id)
+	return storageError(ctx, err)
+}
+
+func validEdit(e Edit) bool {
+	return (e.MemberID == "" || validID(e.MemberID)) && bounded(e.Title, 1024) && bounded(e.Text, document.MaxTextBytes) && bounded(e.Notes, document.MaxTextBytes) && document.ValidateDate(e.Date) == nil
+}
+
+func (s *Store) saveReview(ctx context.Context, id string, e Edit, confirm bool) (Report, error) {
+	if !validEdit(e) || confirm && (e.MemberID == "" || strings.TrimSpace(e.Title) == "") {
+		return Report{}, ErrInvalid
+	}
+	r, err := s.get(ctx, id)
+	if err != nil {
+		return Report{}, err
+	}
+	if r.Status != "review" {
+		return Report{}, ErrState
+	}
+	var member any
+	if e.MemberID != "" {
+		var exists int
+		if err := s.db.QueryRowContext(ctx, "SELECT 1 FROM members WHERE id=?", e.MemberID).Scan(&exists); err != nil {
+			return Report{}, ErrInvalid
+		}
+		member = e.MemberID
+	}
+	status := "review"
+	if confirm {
+		status = "confirmed"
+	}
+	_, err = s.db.ExecContext(ctx, "UPDATE reports SET member_id=?,title=?,report_date=?,corrected_text=?,notes=?,status=? WHERE id=?", member, e.Title, e.Date, e.Text, e.Notes, status, id)
+	if err != nil {
+		return Report{}, storageError(ctx, err)
+	}
+	return s.get(ctx, id)
+}
+
+func (s *Store) SaveReview(ctx context.Context, id string, e Edit) (Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return Report{}, err
+	}
+	return s.saveReview(ctx, id, e, false)
+}
+
+func (s *Store) Confirm(ctx context.Context, id string, e Edit) (Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return Report{}, err
+	}
+	return s.saveReview(ctx, id, e, true)
+}
+
+func (s *Store) list(ctx context.Context, clause string, args ...any) ([]Report, error) {
+	rows, err := s.db.QueryContext(ctx, "SELECT "+reportColumns+" FROM reports "+clause, args...)
+	if err != nil {
+		return nil, storageError(ctx, err)
+	}
+	defer rows.Close()
+	result := []Report{}
+	for rows.Next() {
+		r, err := scanReport(rows)
+		if err != nil {
+			return nil, ErrCorrupt
+		}
+		result = append(result, r)
+	}
+	return result, storageError(ctx, rows.Err())
+}
+
+func (s *Store) Drafts(ctx context.Context) ([]Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return nil, err
+	}
+	return s.list(ctx, "WHERE status <> 'confirmed' ORDER BY created_at DESC,id")
+}
+
+func (s *Store) Search(ctx context.Context, memberID, query string) ([]Report, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return nil, err
+	}
+	if !validID(memberID) || !bounded(query, 1024) {
+		return nil, ErrInvalid
+	}
+	// instr treats %, _ and backslashes literally. SQLite lower folds ASCII;
+	// Chinese characters remain exact, so both intended languages work.
+	return s.list(ctx, "WHERE status='confirmed' AND member_id=? AND (instr(lower(title),lower(?))>0 OR instr(lower(corrected_text),lower(?))>0 OR instr(lower(notes),lower(?))>0) ORDER BY report_date DESC,created_at DESC,id", memberID, query, query, query)
+}
+
+func (s *Store) ReadOriginal(ctx context.Context, id string) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return nil, err
+	}
+	if !validID(id) {
+		return nil, ErrNotFound
+	}
+	var digest string
+	var length int64
+	if err := s.db.QueryRowContext(ctx, "SELECT digest,byte_count FROM reports WHERE id=?", id).Scan(&digest, &length); err != nil {
+		return nil, storageError(ctx, err)
+	}
+	if length < 1 || length > document.MaxFileBytes {
+		return nil, ErrCorrupt
+	}
+	leaf := id + ".blob"
+	info, err := s.originals.Lstat(leaf)
+	if err != nil || !private(info, false) || info.Size() != length {
+		return nil, ErrCorrupt
+	}
+	f, err := s.originals.OpenFile(leaf, os.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, ErrCorrupt
+	}
+	defer f.Close()
+	opened, err := f.Stat()
+	if err != nil || !private(opened, false) || !os.SameFile(info, opened) {
+		return nil, ErrCorrupt
+	}
+	data, err := io.ReadAll(io.LimitReader(f, length+1))
+	if err != nil {
+		return nil, ErrStorage
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	actual := sha256.Sum256(data)
+	if int64(len(data)) != length || hex.EncodeToString(actual[:]) != digest {
+		return nil, ErrCorrupt
+	}
+	if err := s.checkRoot(); err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+
+func (s *Store) DeleteDraft(ctx context.Context, id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return err
+	}
+	r, err := s.get(ctx, id)
+	if err != nil {
+		return err
+	}
+	if r.Status == "confirmed" {
+		return ErrState
+	}
+	_, err = s.db.ExecContext(ctx, "DELETE FROM reports WHERE id=?", id)
+	// Conservative first-phase policy: no automatic physical blob deletion.
+	return storageError(ctx, err)
+}
+
+func (s *Store) Language(ctx context.Context) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return "", err
+	}
+	var language string
+	err := s.db.QueryRowContext(ctx, "SELECT value FROM settings WHERE key='language'").Scan(&language)
+	if err != nil {
+		return "", storageError(ctx, err)
+	}
+	if language != "system" && language != "zh-Hans" && language != "en" {
+		return "", ErrCorrupt
+	}
+	return language, nil
+}
+
+func (s *Store) SetLanguage(ctx context.Context, language string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := s.begin(ctx); err != nil {
+		return err
+	}
+	if language != "system" && language != "zh-Hans" && language != "en" {
+		return ErrInvalid
+	}
+	_, err := s.db.ExecContext(ctx, "UPDATE settings SET value=? WHERE key='language'", language)
+	return storageError(ctx, err)
+}
