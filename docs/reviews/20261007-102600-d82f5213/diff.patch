diff --git a/internal/app/native_integration_darwin_test.go b/internal/app/native_integration_darwin_test.go
new file mode 100644
index 0000000..fd53ebe
--- /dev/null
+++ b/internal/app/native_integration_darwin_test.go
@@ -0,0 +1,179 @@
+//go:build darwin
+
+package app_test
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"image"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"kinlogue/internal/app"
+	"kinlogue/internal/document"
+	"kinlogue/internal/library"
+	"kinlogue/internal/macos"
+)
+
+type nativeProcessor struct{}
+
+func (nativeProcessor) Extract(ctx context.Context, data []byte) (document.Extraction, error) {
+	return macos.Extract(ctx, data)
+}
+
+func (nativeProcessor) RenderPage(ctx context.Context, data []byte, page int) (image.Image, error) {
+	return macos.RenderPage(ctx, data, page)
+}
+
+// This integration uses the production file reader, PDFKit processor, service,
+// and SQLite store together. Temporary paths are injected only by this test;
+// the production composition root still requires its sandboxed bundle identity.
+func TestNativeReportWorkflowSurvivesReopen(t *testing.T) {
+	ctx := context.Background()
+	root := filepath.Join(t.TempDir(), "library")
+	source := filepath.Join(t.TempDir(), "synthetic.pdf")
+	original := integrationPDF()
+	if err := os.WriteFile(source, original, 0600); err != nil {
+		t.Fatal("could not create synthetic source")
+	}
+	open := func() (*app.Service, *library.Store) {
+		t.Helper()
+		store, err := library.Open(root)
+		if err != nil {
+			t.Fatalf("open library: %v", err)
+		}
+		service := app.New(store, nativeProcessor{}, macos.ReadImportedFile)
+		t.Cleanup(func() {
+			if err := service.Close(); err != nil {
+				t.Errorf("close library: %v", err)
+			}
+		})
+		return service, store
+	}
+	assertSearch := func(service *app.Service, member, query string, count int) {
+		t.Helper()
+		rows, err := service.Search(ctx, member, query)
+		if err != nil || len(rows) != count {
+			t.Fatalf("search visibility: count=%d want=%d error=%v", len(rows), count, err)
+		}
+	}
+
+	service, _ := open()
+	member, err := service.AddMember(ctx, "Synthetic member A")
+	if err != nil {
+		t.Fatal(err)
+	}
+	other, err := service.AddMember(ctx, "Synthetic member B")
+	if err != nil {
+		t.Fatal(err)
+	}
+	report, err := service.Import(ctx, source)
+	if err != nil || report.Status != "review" {
+		t.Fatalf("native import: status=%s error=%v", report.Status, err)
+	}
+	raw := report.Extraction
+	if raw.Kind != "pdf" || raw.PageCount != 2 || len(raw.Blocks) != 2 {
+		t.Fatal("native extraction lost PDF pages")
+	}
+	for i, block := range raw.Blocks {
+		if block.Page != i+1 || block.Method != "pdfTextLayer" || block.Bounds.Width <= 0 || block.Bounds.Height <= 0 {
+			t.Fatal("native extraction lost page provenance")
+		}
+		if !strings.Contains(block.Text, fmt.Sprintf("RAW SOURCE PAGE %d", i+1)) {
+			t.Fatal("native extraction lost synthetic source anchor")
+		}
+	}
+	if report.Review.Text != raw.Text() {
+		t.Fatal("initial review did not receive native transcription")
+	}
+	assertSearch(service, member.ID, "", 0)
+	edit := library.Edit{MemberID: member.ID, Title: "合成复核报告", Date: "2026-10-07", Text: "人工修正转录", Notes: "合成备注"}
+	if _, err := service.SaveReview(ctx, report.ID, edit); err != nil {
+		t.Fatal(err)
+	}
+	assertSearch(service, member.ID, "修正", 0)
+	if err := service.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	// A fresh store and service must recover the saved candidate and immutable
+	// source without recognition running again or confirmation being implied.
+	service, store := open()
+	reopened, err := service.Get(ctx, report.ID)
+	if err != nil || reopened.Status != "review" || reopened.Review != edit || !reflect.DeepEqual(reopened.Extraction, raw) {
+		t.Fatal("saved review or native provenance changed after reopen")
+	}
+	members, err := service.Members(ctx)
+	if err != nil || len(members) != 2 {
+		t.Fatal("members did not survive reopen")
+	}
+	drafts, err := service.Drafts(ctx)
+	if err != nil || len(drafts) != 1 || drafts[0].ID != report.ID {
+		t.Fatal("saved review missing from drafts")
+	}
+	assertSearch(service, member.ID, "", 0)
+	preview, err := service.Preview(ctx, report.ID, 2)
+	if err != nil || preview == nil || preview.Bounds().Dx() != 1200 || preview.Bounds().Dy() != 1600 {
+		t.Fatalf("native page preview failed: %v", err)
+	}
+	data, err := store.ReadOriginal(ctx, report.ID)
+	if err != nil || !bytes.Equal(data, original) {
+		t.Fatal("stored original changed across import and reopen")
+	}
+	confirmed, err := service.Confirm(ctx, report.ID, reopened.Review)
+	if err != nil || confirmed.Status != "confirmed" || !reflect.DeepEqual(confirmed.Extraction, raw) {
+		t.Fatal("confirmation changed source extraction or failed")
+	}
+	assertSearch(service, member.ID, "修正", 1)
+	assertSearch(service, member.ID, "RAW SOURCE", 0)
+	assertSearch(service, other.ID, "", 0)
+	if err := service.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	service, _ = open()
+	confirmed, err = service.Get(ctx, report.ID)
+	if err != nil || confirmed.Status != "confirmed" || confirmed.Review != edit || !reflect.DeepEqual(confirmed.Extraction, raw) {
+		t.Fatal("confirmed record or provenance changed after second reopen")
+	}
+	assertSearch(service, member.ID, "修正", 1)
+	assertSearch(service, other.ID, "", 0)
+	if drafts, err := service.Drafts(ctx); err != nil || len(drafts) != 0 {
+		t.Fatal("confirmed record still appears in drafts")
+	}
+	if data, err := os.ReadFile(source); err != nil || !bytes.Equal(data, original) {
+		t.Fatal("import modified the selected source")
+	}
+}
+
+// A generated two-page text PDF avoids binary fixtures and deliberately gives
+// each page a different non-medical anchor so incorrect source ordering fails.
+func integrationPDF() []byte {
+	objects := []string{"<< /Type /Catalog /Pages 2 0 R >>", ""}
+	kids := make([]string, 2)
+	for i := range 2 {
+		pageID := len(objects) + 1
+		kids[i] = fmt.Sprintf("%d 0 R", pageID)
+		content := fmt.Sprintf("BT /F1 28 Tf 40 100 Td (RAW SOURCE PAGE %d) Tj ET", i+1)
+		objects = append(objects, fmt.Sprintf("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 600 800] /Resources << /Font << /F1 << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> >> >> /Contents %d 0 R >>", pageID+1), fmt.Sprintf("<< /Length %d >>\nstream\n%s\nendstream", len(content), content))
+	}
+	objects[1] = fmt.Sprintf("<< /Type /Pages /Kids [%s] /Count 2 >>", strings.Join(kids, " "))
+	var buf bytes.Buffer
+	buf.WriteString("%PDF-1.4\n")
+	offsets := []int{0}
+	for i, object := range objects {
+		offsets = append(offsets, buf.Len())
+		fmt.Fprintf(&buf, "%d 0 obj\n%s\nendobj\n", i+1, object)
+	}
+	xref := buf.Len()
+	fmt.Fprintf(&buf, "xref\n0 %d\n0000000000 65535 f \n", len(offsets))
+	for _, offset := range offsets[1:] {
+		fmt.Fprintf(&buf, "%010d 00000 n \n", offset)
+	}
+	fmt.Fprintf(&buf, "trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n", len(offsets), xref)
+	return buf.Bytes()
+}
diff --git a/internal/app/service.go b/internal/app/service.go
new file mode 100644
index 0000000..40483a3
--- /dev/null
+++ b/internal/app/service.go
@@ -0,0 +1,250 @@
+// Package app composes the local library and recognition backend. Every command
+// participates in shutdown; mutations share one cancellable admission queue.
+package app
+
+import (
+	"context"
+	"errors"
+	"image"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"kinlogue/internal/document"
+	"kinlogue/internal/library"
+)
+
+var (
+	ErrClosed = errors.New("application_closed")
+	ErrImport = errors.New("import_failed")
+)
+
+// Processor produces an untrusted transcription candidate, never a confirmed
+// medical conclusion. Native OCR is the only production implementation today.
+type Processor interface {
+	Extract(context.Context, []byte) (document.Extraction, error)
+	RenderPage(context.Context, []byte, int) (image.Image, error)
+}
+
+type Service struct {
+	store      *library.Store
+	processor  Processor
+	readFile   func(string) ([]byte, error)
+	shutdown   context.Context
+	cancel     context.CancelFunc
+	mutations  chan struct{}
+	mu         sync.Mutex
+	closing    bool
+	ops        sync.WaitGroup
+	closed     chan struct{}
+	closeError error
+}
+
+func New(s *library.Store, p Processor, readFile func(string) ([]byte, error)) *Service {
+	c, cancel := context.WithCancel(context.Background())
+	return &Service{store: s, processor: p, readFile: readFile, shutdown: c, cancel: cancel, mutations: make(chan struct{}, 1), closed: make(chan struct{})}
+}
+
+func command[T any](s *Service, ctx context.Context, mutation bool, fn func(context.Context) (T, error)) (T, error) {
+	var zero T
+	s.mu.Lock()
+	if s.closing {
+		s.mu.Unlock()
+		return zero, ErrClosed
+	}
+	s.ops.Add(1)
+	s.mu.Unlock()
+	defer s.ops.Done()
+	c, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(s.shutdown, cancel)
+	defer stop()
+	defer cancel()
+	if mutation {
+		select {
+		case s.mutations <- struct{}{}:
+			defer func() { <-s.mutations }()
+		case <-c.Done():
+			return zero, c.Err()
+		}
+	}
+	if err := c.Err(); err != nil {
+		return zero, err
+	}
+	return fn(c)
+}
+
+// Close stops admission, cancels entered commands and waits for the native
+// recognizer to return before closing SQLite. A native call may not interrupt.
+func (s *Service) Close() error {
+	s.mu.Lock()
+	if s.closing {
+		s.mu.Unlock()
+		<-s.closed
+		return s.closeError
+	}
+	s.closing = true
+	s.cancel()
+	s.mu.Unlock()
+	s.ops.Wait()
+	s.closeError = s.store.Close()
+	close(s.closed)
+	return s.closeError
+}
+
+func (s *Service) Import(ctx context.Context, path string) (library.Report, error) {
+	return command(s, ctx, true, func(c context.Context) (library.Report, error) {
+		data, err := s.readFile(path)
+		if err != nil {
+			return library.Report{}, safeImportError(err)
+		}
+		if err := c.Err(); err != nil {
+			return library.Report{}, err
+		}
+		if len(data) == 0 || len(data) > document.MaxFileBytes {
+			return library.Report{}, document.ErrLimit
+		}
+		r, err := s.store.CreateDraft(c, filepath.Base(path), data)
+		if err != nil {
+			return r, err
+		}
+		return s.recognize(c, r, data)
+	})
+}
+
+func (s *Service) Retry(ctx context.Context, id string) (library.Report, error) {
+	return command(s, ctx, true, func(c context.Context) (library.Report, error) {
+		r, err := s.store.Get(c, id)
+		if err != nil {
+			return r, err
+		}
+		if r.Status != "failed" || r.Extraction.Engine != "" {
+			return r, library.ErrState
+		}
+		data, err := s.store.ReadOriginal(c, id)
+		if err != nil {
+			return r, err
+		}
+		return s.recognize(c, r, data)
+	})
+}
+
+func (s *Service) recognize(c context.Context, r library.Report, data []byte) (library.Report, error) {
+	e, err := s.processor.Extract(c, data)
+	if c.Err() != nil {
+		err = c.Err()
+	}
+	if err == nil {
+		err = e.Validate()
+	}
+	if err == nil {
+		var saved library.Report
+		saved, err = s.store.SaveExtraction(c, r.ID, e)
+		if err == nil {
+			return saved, nil
+		}
+	} else {
+		err = safeImportError(err)
+	}
+	// Cancellation must leave a retryable draft. This bounded cleanup remains
+	// registered with shutdown and never competes with another mutation.
+	cleanup, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	// If SQLite cannot persist this failure (or its earlier commit succeeded
+	// despite an ambiguous error), preserve the original error and never undo
+	// an already published review. Open recovers any remaining processing row.
+	_ = s.store.FailDraft(cleanup, r.ID, failureCode(err))
+	if failed, getErr := s.store.Get(cleanup, r.ID); getErr == nil {
+		r = failed
+	}
+	return r, err
+}
+
+func safeImportError(err error) error {
+	for _, known := range []error{context.Canceled, context.DeadlineExceeded, document.ErrInvalid, document.ErrUnsupported, document.ErrLimit, document.ErrLocked, document.ErrUnavailable} {
+		if errors.Is(err, known) {
+			return known
+		}
+	}
+	return ErrImport
+}
+func failureCode(err error) string {
+	switch {
+	case errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		return "cancelled"
+	case errors.Is(err, document.ErrLimit):
+		return "limit"
+	case errors.Is(err, document.ErrLocked):
+		return "locked"
+	case errors.Is(err, document.ErrUnsupported):
+		return "unsupported"
+	case errors.Is(err, document.ErrInvalid):
+		return "invalid"
+	case errors.Is(err, document.ErrUnavailable):
+		return "unavailable"
+	default:
+		return "recognition_failed"
+	}
+}
+
+func (s *Service) Preview(ctx context.Context, id string, page int) (image.Image, error) {
+	return command(s, ctx, false, func(c context.Context) (image.Image, error) {
+		r, err := s.store.Get(c, id)
+		if err != nil {
+			return nil, err
+		}
+		// A readable original can still help after recognition fails. Permit
+		// its first page; the native adapter validates the actual page count.
+		maxPage := r.Extraction.PageCount
+		if maxPage == 0 && r.Status == "failed" {
+			maxPage = 1
+		}
+		if page < 1 || page > maxPage {
+			return nil, document.ErrInvalid
+		}
+		data, err := s.store.ReadOriginal(c, id)
+		if err != nil {
+			return nil, err
+		}
+		img, err := s.processor.RenderPage(c, data, page)
+		if c.Err() != nil {
+			return nil, c.Err()
+		}
+		if err != nil {
+			return nil, safeImportError(err)
+		}
+		return img, nil
+	})
+}
+
+func (s *Service) Members(c context.Context) ([]library.Member, error) {
+	return command(s, c, false, s.store.Members)
+}
+func (s *Service) AddMember(c context.Context, name string) (library.Member, error) {
+	return command(s, c, true, func(c context.Context) (library.Member, error) { return s.store.AddMember(c, name) })
+}
+func (s *Service) Drafts(c context.Context) ([]library.Report, error) {
+	return command(s, c, false, s.store.Drafts)
+}
+func (s *Service) Search(c context.Context, memberID, query string) ([]library.Report, error) {
+	return command(s, c, false, func(c context.Context) ([]library.Report, error) { return s.store.Search(c, memberID, query) })
+}
+func (s *Service) Get(c context.Context, id string) (library.Report, error) {
+	return command(s, c, false, func(c context.Context) (library.Report, error) { return s.store.Get(c, id) })
+}
+func (s *Service) SaveReview(c context.Context, id string, e library.Edit) (library.Report, error) {
+	return command(s, c, true, func(c context.Context) (library.Report, error) { return s.store.SaveReview(c, id, e) })
+}
+func (s *Service) Confirm(c context.Context, id string, e library.Edit) (library.Report, error) {
+	return command(s, c, true, func(c context.Context) (library.Report, error) { return s.store.Confirm(c, id, e) })
+}
+func (s *Service) DeleteDraft(c context.Context, id string) error {
+	_, err := command(s, c, true, func(c context.Context) (struct{}, error) { return struct{}{}, s.store.DeleteDraft(c, id) })
+	return err
+}
+func (s *Service) Language(c context.Context) (string, error) {
+	return command(s, c, false, s.store.Language)
+}
+func (s *Service) SetLanguage(c context.Context, language string) error {
+	_, err := command(s, c, true, func(c context.Context) (struct{}, error) { return struct{}{}, s.store.SetLanguage(c, language) })
+	return err
+}
diff --git a/internal/app/service_test.go b/internal/app/service_test.go
new file mode 100644
index 0000000..5f7fb2d
--- /dev/null
+++ b/internal/app/service_test.go
@@ -0,0 +1,159 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"image"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"kinlogue/internal/document"
+	"kinlogue/internal/library"
+)
+
+type processor struct {
+	extract func(context.Context, []byte) (document.Extraction, error)
+}
+
+func (p processor) Extract(c context.Context, b []byte) (document.Extraction, error) {
+	return p.extract(c, b)
+}
+func (p processor) RenderPage(context.Context, []byte, int) (image.Image, error) {
+	return image.NewRGBA(image.Rect(0, 0, 2, 2)), nil
+}
+
+func synthetic() document.Extraction {
+	return document.Extraction{Kind: "pdf", PageCount: 1, Engine: "synthetic", Blocks: []document.Block{{Page: 1, Text: "Synthetic OCR", Method: "synthetic", Confidence: 1}}}
+}
+
+func newTestService(t *testing.T, p Processor) (*Service, *library.Store) {
+	t.Helper()
+	s, err := library.Open(filepath.Join(t.TempDir(), "library"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := New(s, p, func(string) ([]byte, error) { return []byte("synthetic-original"), nil })
+	t.Cleanup(func() { _ = a.Close() })
+	return a, s
+}
+
+func TestImportReviewConfirmSearchRealStorage(t *testing.T) {
+	a, s := newTestService(t, processor{func(context.Context, []byte) (document.Extraction, error) { return synthetic(), nil }})
+	c := context.Background()
+	m, err := a.AddMember(c, "Synthetic member")
+	if err != nil {
+		t.Fatal(err)
+	}
+	r, err := a.Import(c, "/synthetic/input.pdf")
+	if err != nil || r.Status != "review" || r.FileName != "input.pdf" {
+		t.Fatalf("import: %v, %s", err, r.Status)
+	}
+	if rows, err := a.Search(c, m.ID, ""); err != nil || len(rows) != 0 {
+		t.Fatal("draft searchable")
+	}
+	edit := library.Edit{MemberID: m.ID, Title: "合成检查", Date: "2026-10-07", Text: "用户确认的文字"}
+	if _, err := a.SaveReview(c, r.ID, edit); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := a.Confirm(c, r.ID, edit); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := a.Search(c, m.ID, "确认")
+	if err != nil || len(rows) != 1 {
+		t.Fatal("confirmed transcript missing")
+	}
+	got, err := s.Get(c, r.ID)
+	if err != nil || got.Extraction.Text() != "Synthetic OCR" {
+		t.Fatal("source extraction overwritten")
+	}
+	if _, err := a.Preview(c, r.ID, 1); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := a.Preview(c, r.ID, 2); !errors.Is(err, document.ErrInvalid) {
+		t.Fatal("invalid preview page accepted")
+	}
+}
+
+func TestCancelledRecognitionCannotPublishLateSuccess(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	a, s := newTestService(t, processor{func(context.Context, []byte) (document.Extraction, error) {
+		close(entered)
+		<-release
+		return synthetic(), nil
+	}})
+	c, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { _, err := a.Import(c, "/synthetic/input.pdf"); done <- err }()
+	<-entered
+	cancel()
+	close(release)
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected cancellation, got %v", err)
+	}
+	rows, err := s.Drafts(context.Background())
+	if err != nil || len(rows) != 1 || rows[0].Status != "failed" || len(rows[0].Extraction.Blocks) != 0 {
+		t.Fatal("late success published")
+	}
+}
+
+func TestCloseCancelsAndWaitsBeforeClosingStorage(t *testing.T) {
+	entered := make(chan struct{})
+	cancelled := make(chan struct{})
+	release := make(chan struct{})
+	a, _ := newTestService(t, processor{func(c context.Context, _ []byte) (document.Extraction, error) {
+		close(entered)
+		<-c.Done()
+		close(cancelled)
+		<-release
+		return synthetic(), nil
+	}})
+	done := make(chan error, 1)
+	go func() { _, err := a.Import(context.Background(), "/synthetic/input.pdf"); done <- err }()
+	<-entered
+	closed := make(chan error, 1)
+	go func() { closed <- a.Close() }()
+	<-cancelled
+	select {
+	case <-closed:
+		t.Fatal("closed before recognition settled")
+	case <-time.After(20 * time.Millisecond):
+	}
+	if _, err := a.Members(context.Background()); !errors.Is(err, ErrClosed) {
+		t.Fatal("command admitted while closing")
+	}
+	close(release)
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatal("shutdown did not cancel import")
+	}
+	if err := <-closed; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestRetryDoesNotOverwriteReviewedReport(t *testing.T) {
+	calls := 0
+	a, _ := newTestService(t, processor{func(context.Context, []byte) (document.Extraction, error) {
+		calls++
+		if calls == 1 {
+			return document.Extraction{}, document.ErrUnavailable
+		}
+		return synthetic(), nil
+	}})
+	c := context.Background()
+	r, err := a.Import(c, "/synthetic/input.pdf")
+	if !errors.Is(err, document.ErrUnavailable) || r.Status != "failed" {
+		t.Fatal("failure not persisted")
+	}
+	r, err = a.Retry(c, r.ID)
+	if err != nil || r.Status != "review" {
+		t.Fatal("explicit retry failed")
+	}
+	if _, err := a.Retry(c, r.ID); !errors.Is(err, library.ErrState) {
+		t.Fatal("reviewed source could be replaced")
+	}
+	if calls != 2 {
+		t.Fatal("invalid retry reached OCR")
+	}
+}
diff --git a/internal/desktop/desktop.go b/internal/desktop/desktop.go
new file mode 100644
index 0000000..2cdc425
--- /dev/null
+++ b/internal/desktop/desktop.go
@@ -0,0 +1,548 @@
+// Package desktop renders the native report workflow. State belongs to the
+// main thread; background operations publish through Window.Update.
+package desktop
+
+import (
+	"context"
+	"errors"
+	"image"
+	"strings"
+
+	"github.com/egoist/mygo"
+	"github.com/egoist/mygo/ui"
+	"kinlogue/internal/document"
+	"kinlogue/internal/library"
+	"kinlogue/internal/macos"
+)
+
+type Backend interface {
+	Members(context.Context) ([]library.Member, error)
+	AddMember(context.Context, string) (library.Member, error)
+	Drafts(context.Context) ([]library.Report, error)
+	Search(context.Context, string, string) ([]library.Report, error)
+	Get(context.Context, string) (library.Report, error)
+	Import(context.Context, string) (library.Report, error)
+	Retry(context.Context, string) (library.Report, error)
+	SaveReview(context.Context, string, library.Edit) (library.Report, error)
+	Confirm(context.Context, string, library.Edit) (library.Report, error)
+	Preview(context.Context, string, int) (image.Image, error)
+	DeleteDraft(context.Context, string) error
+	Language(context.Context) (string, error)
+	SetLanguage(context.Context, string) error
+}
+
+type screen struct {
+	backend                          Backend
+	win                              *mygo.Window
+	post                             func(func())
+	ctx                              context.Context
+	stop                             context.CancelFunc
+	jobCancel                        context.CancelFunc
+	previewCancel                    context.CancelFunc
+	previewGate                      chan struct{}
+	jobGeneration, previewGeneration uint64
+	closed, allowClose               bool
+	busy, message                    string
+	cancellable, cancelling          bool
+	language, systemLanguage         string
+	members                          []library.Member
+	drafts, records                  []library.Report
+	memberID, query                  string
+	report                           library.Report
+	edit                             library.Edit
+	page                             int
+	sourcePage                       int
+	sourceText                       string
+	bitmap                           *ui.Bitmap
+	previewBusy                      bool
+	previewError                     string
+	pending                          func()
+	newMember, deletePrompt, showRaw bool
+	memberName                       string
+}
+
+func newScreen(backend Backend, systemLanguage string) *screen {
+	ctx, stop := context.WithCancel(context.Background())
+	return &screen{backend: backend, ctx: ctx, stop: stop, language: "system", systemLanguage: systemLanguage, page: 1, previewGate: make(chan struct{}, 1)}
+}
+
+func Run(backend Backend) error {
+	s := newScreen(backend, macos.PreferredLanguage())
+	defer s.stop()
+	mygo.App.WhenReady(func() {
+		mygo.Theme.SetSource(mygo.ThemeLight)
+		s.win = mygo.NewWindow(mygo.WindowOptions{Title: s.t("app"), Width: 1240, Height: 880, MinWidth: 1080, MinHeight: 700, Content: ui.View(s.view)})
+		s.post = s.win.Update
+		s.updateChrome()
+		s.win.OnClose(func(e *mygo.CloseEvent) {
+			if s.allowClose {
+				return
+			}
+			e.PreventDefault()
+			s.win.Update(func() { s.leave(func() { s.allowClose = true; s.win.Close() }) })
+		})
+		s.win.OnClosed(func() { s.closed = true; s.stop() })
+		mygo.App.OnWindowAllClosed(func() { mygo.App.Quit() })
+		mygo.App.OnBeforeQuit(func(e *mygo.QuitEvent) {
+			if s.allowClose || s.closed {
+				return
+			}
+			e.PreventDefault()
+			s.win.Update(func() { s.leave(func() { s.allowClose = true; s.stop(); mygo.App.Quit() }) })
+		})
+		s.load(true)
+	})
+	return mygo.App.Run()
+}
+
+func (s *screen) t(key string, args ...any) string {
+	lang := s.language
+	if lang == "system" {
+		lang = s.systemLanguage
+	}
+	return translate(lang, key, args...)
+}
+
+func (s *screen) updateChrome() {
+	if s.win == nil {
+		return
+	}
+	s.win.SetTitle(s.t("app"))
+	mygo.App.SetMenu(mygo.NewMenu([]*mygo.MenuItem{
+		{Label: s.t("app"), Submenu: []*mygo.MenuItem{{Label: s.t("quit"), Role: mygo.RoleQuit}}},
+		{Label: s.t("file_menu"), Submenu: []*mygo.MenuItem{{Label: s.t("import"), Accelerator: "CmdOrCtrl+O", Click: func(*mygo.MenuItem, *mygo.Window) { s.win.Update(func() { s.leave(s.chooseFiles) }) }}}},
+		{Label: s.t("edit_menu"), Submenu: []*mygo.MenuItem{
+			{Label: s.t("undo"), Role: mygo.RoleUndo}, {Label: s.t("redo"), Role: mygo.RoleRedo}, mygo.Separator(),
+			{Label: s.t("cut"), Role: mygo.RoleCut}, {Label: s.t("copy"), Role: mygo.RoleCopy}, {Label: s.t("paste"), Role: mygo.RolePaste}, {Label: s.t("select_all"), Role: mygo.RoleSelectAll},
+		}},
+	}))
+}
+
+// job captures inputs before starting and accepts only this operation's result.
+// Work returns a main-thread closure; no background goroutine reads UI fields.
+func (s *screen) job(key string, cancellable bool, work func(context.Context) func()) {
+	if s.busy != "" || s.closed {
+		return
+	}
+	s.jobGeneration++
+	generation := s.jobGeneration
+	ctx, cancel := context.WithCancel(s.ctx)
+	s.jobCancel, s.busy, s.cancellable, s.cancelling = cancel, key, cancellable, false
+	go func() {
+		complete := work(ctx)
+		cancel()
+		s.post(func() {
+			if s.closed || generation != s.jobGeneration {
+				return
+			}
+			s.busy, s.cancellable, s.cancelling, s.jobCancel = "", false, false, nil
+			complete()
+		})
+	}()
+}
+
+type snapshot struct {
+	members         []library.Member
+	drafts, records []library.Report
+	language        string
+}
+
+func (s *screen) read(ctx context.Context, member, query string, language bool) (snapshot, error) {
+	var result snapshot
+	var err error
+	if result.members, err = s.backend.Members(ctx); err != nil {
+		return result, err
+	}
+	if result.drafts, err = s.backend.Drafts(ctx); err != nil {
+		return result, err
+	}
+	if member != "" {
+		if result.records, err = s.backend.Search(ctx, member, query); err != nil {
+			return result, err
+		}
+	}
+	if language {
+		result.language, err = s.backend.Language(ctx)
+	}
+	return result, err
+}
+
+func (s *screen) apply(data snapshot) {
+	s.members, s.drafts, s.records = data.members, data.drafts, data.records
+	if data.language != "" {
+		s.language = data.language
+		s.updateChrome()
+	}
+}
+
+func (s *screen) load(language bool) {
+	member, query := s.memberID, s.query
+	s.job("loading", false, func(ctx context.Context) func() {
+		data, err := s.read(ctx, member, query, language)
+		return func() {
+			if err != nil {
+				s.message = "load_failed"
+				return
+			}
+			s.apply(data)
+		}
+	})
+}
+
+func (s *screen) dirty() bool {
+	return s.report.ID != "" && s.report.Status == "review" && s.edit != s.report.Review
+}
+
+func (s *screen) leave(next func()) {
+	if s.busy != "" {
+		s.message = "wait_busy"
+		return
+	}
+	if s.dirty() {
+		s.pending = next
+		return
+	}
+	next()
+}
+
+func (s *screen) selectMember(id string) {
+	s.leave(func() { s.clearReport(); s.memberID, s.query, s.message = id, "", ""; s.load(false) })
+}
+
+func (s *screen) clearReport() {
+	s.previewGeneration++
+	if s.previewCancel != nil {
+		s.previewCancel()
+	}
+	s.report, s.edit, s.bitmap, s.page, s.previewError, s.previewBusy, s.showRaw = library.Report{}, library.Edit{}, nil, 1, "", false, false
+	s.sourcePage, s.sourceText = 0, ""
+}
+
+func (s *screen) accept(report library.Report) {
+	s.report, s.edit = report, report.Review
+	s.showRaw = false
+	s.sourcePage, s.sourceText = 0, ""
+}
+
+func (s *screen) initialText() string {
+	if s.sourcePage == s.page {
+		return s.sourceText
+	}
+	parts := []string{}
+	for _, block := range s.report.Extraction.Blocks {
+		if block.Page == s.page {
+			parts = append(parts, block.Text)
+		}
+	}
+	// Recognition is immutable between report snapshots. Retain only the
+	// selected page instead of joining up to 1 MiB again on every UI frame.
+	s.sourcePage, s.sourceText = s.page, strings.Join(parts, "\n")
+	return s.sourceText
+}
+
+func (s *screen) open(id string) {
+	s.leave(func() {
+		s.job("loading", false, func(ctx context.Context) func() {
+			report, err := s.backend.Get(ctx, id)
+			return func() {
+				if err != nil {
+					s.message = "load_failed"
+					return
+				}
+				s.clearReport()
+				s.accept(report)
+				s.message = ""
+				s.preview(1)
+			}
+		})
+	})
+}
+
+func (s *screen) preview(page int) {
+	if s.report.ID == "" || page < 1 || page > max(1, s.report.Extraction.PageCount) {
+		return
+	}
+	s.previewGeneration++
+	generation, id := s.previewGeneration, s.report.ID
+	if s.previewCancel != nil {
+		s.previewCancel()
+	}
+	ctx, cancel := context.WithCancel(s.ctx)
+	s.previewCancel, s.page, s.bitmap, s.previewBusy, s.previewError = cancel, page, nil, true, ""
+	go func() {
+		// Native decoding is not necessarily interruptible. Keep at most one
+		// call in flight while cancelled, queued page requests exit promptly.
+		select {
+		case s.previewGate <- struct{}{}:
+		case <-ctx.Done():
+			return
+		}
+		if ctx.Err() != nil {
+			<-s.previewGate
+			return
+		}
+		img, err := s.backend.Preview(ctx, id, page)
+		<-s.previewGate
+		var bitmap *ui.Bitmap
+		if ctx.Err() == nil && err == nil && img != nil && img.Bounds().Dx() > 0 && img.Bounds().Dy() > 0 && img.Bounds().Dx() <= document.MaxRenderEdge && img.Bounds().Dy() <= document.MaxRenderEdge {
+			bitmap = ui.NewBitmap(img)
+		}
+		cancel()
+		s.post(func() {
+			if s.closed || generation != s.previewGeneration || s.report.ID != id {
+				return
+			}
+			s.previewBusy = false
+			if bitmap == nil {
+				s.previewError = "preview_failed"
+				return
+			}
+			s.bitmap = bitmap
+		})
+	}()
+}
+
+func (s *screen) canConfirm() bool {
+	if s.report.Status != "review" || strings.TrimSpace(s.edit.Title) == "" || document.ValidateDate(s.edit.Date) != nil {
+		return false
+	}
+	for _, member := range s.members {
+		if member.ID == s.edit.MemberID {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *screen) save(confirm bool, after func()) {
+	if document.ValidateDate(s.edit.Date) != nil {
+		s.message = "invalid_date"
+		return
+	}
+	if confirm && !s.canConfirm() {
+		s.message = "invalid_review"
+		return
+	}
+	id, edit, member, query := s.report.ID, s.edit, s.memberID, s.query
+	s.job("saving", false, func(ctx context.Context) func() {
+		var report library.Report
+		var err error
+		if confirm {
+			report, err = s.backend.Confirm(ctx, id, edit)
+		} else {
+			report, err = s.backend.SaveReview(ctx, id, edit)
+		}
+		var data snapshot
+		var loadErr error
+		if err == nil {
+			data, loadErr = s.read(ctx, member, query, false)
+		}
+		return func() {
+			if err != nil {
+				s.message = "save_failed"
+				return
+			}
+			s.accept(report)
+			if loadErr == nil {
+				s.apply(data)
+			}
+			s.message = "saved"
+			if confirm {
+				s.message = "confirmed"
+			}
+			if loadErr != nil {
+				s.message = "load_failed"
+			}
+			if after != nil {
+				s.pending = nil
+				after()
+			}
+		}
+	})
+}
+
+func (s *screen) chooseFiles() {
+	if s.win == nil || s.busy != "" {
+		return
+	}
+	parent, title, detail, filter := s.win, s.t("import"), s.t("import_detail"), s.t("formats")
+	s.job("loading", false, func(ctx context.Context) func() {
+		paths, err := mygo.Dialog.Open(mygo.OpenDialogOptions{Parent: parent, Title: title, Message: detail, Multiple: true, Filters: []mygo.FileFilter{{Name: filter, Extensions: []string{"pdf", "jpg", "jpeg", "png", "heic", "tif", "tiff"}}}})
+		return func() {
+			if err != nil {
+				s.message = "import_failed"
+				return
+			}
+			if len(paths) > 0 {
+				s.importFiles(paths)
+			}
+		}
+	})
+}
+
+func (s *screen) importFiles(paths []string) {
+	member, query := s.memberID, s.query
+	s.job("importing", true, func(ctx context.Context) func() {
+		var latest library.Report
+		var failure error
+		for _, path := range paths {
+			if ctx.Err() != nil {
+				failure = ctx.Err()
+				break
+			}
+			report, err := s.backend.Import(ctx, path)
+			if report.ID != "" {
+				latest = report
+			}
+			if err != nil {
+				failure = err
+			}
+		}
+		// Cancellation stops processing, but reload uses the screen lifetime to
+		// reveal drafts that were durably imported before the cancellation.
+		data, loadErr := s.read(s.ctx, member, query, false)
+		return func() {
+			if loadErr == nil {
+				s.apply(data)
+			}
+			s.message = errorKey(failure, "import_failed")
+			if latest.ID != "" {
+				s.clearReport()
+				s.accept(latest)
+				s.preview(1)
+			}
+		}
+	})
+}
+
+func (s *screen) retry() {
+	id, member, query := s.report.ID, s.memberID, s.query
+	s.job("processing", true, func(ctx context.Context) func() {
+		report, err := s.backend.Retry(ctx, id)
+		data, loadErr := s.read(s.ctx, member, query, false)
+		return func() {
+			if loadErr == nil {
+				s.apply(data)
+			}
+			s.message = errorKey(err, "recognition_failed")
+			if report.ID != "" {
+				s.accept(report)
+				s.preview(1)
+			}
+		}
+	})
+}
+
+func (s *screen) addMember() {
+	name, member, query := strings.TrimSpace(s.memberName), s.memberID, s.query
+	if name == "" {
+		return
+	}
+	s.job("saving", false, func(ctx context.Context) func() {
+		_, err := s.backend.AddMember(ctx, name)
+		var data snapshot
+		var loadErr error
+		if err == nil {
+			data, loadErr = s.read(ctx, member, query, false)
+		}
+		return func() {
+			if err != nil {
+				s.message = "member_failed"
+				return
+			}
+			if loadErr == nil {
+				s.apply(data)
+			}
+			s.newMember = false
+			s.memberName = ""
+			s.message = ""
+			if loadErr != nil {
+				s.message = "load_failed"
+			}
+		}
+	})
+}
+
+func (s *screen) deleteDraft() {
+	id, member, query := s.report.ID, s.memberID, s.query
+	s.job("deleting", false, func(ctx context.Context) func() {
+		err := s.backend.DeleteDraft(ctx, id)
+		var data snapshot
+		var loadErr error
+		if err == nil {
+			data, loadErr = s.read(ctx, member, query, false)
+		}
+		return func() {
+			if err != nil {
+				s.message = "delete_failed"
+				return
+			}
+			s.clearReport()
+			if loadErr == nil {
+				s.apply(data)
+			} else {
+				s.drafts = nil
+			}
+			s.deletePrompt = false
+			s.message = ""
+			if loadErr != nil {
+				s.message = "load_failed"
+			}
+		}
+	})
+}
+
+func (s *screen) changeLanguage(language string) {
+	s.job("saving", false, func(ctx context.Context) func() {
+		err := s.backend.SetLanguage(ctx, language)
+		return func() {
+			if err != nil {
+				s.message = "language_failed"
+				return
+			}
+			s.language = language
+			s.updateChrome()
+		}
+	})
+}
+
+func errorKey(err error, fallback string) string {
+	if err == nil {
+		return ""
+	}
+	switch {
+	case errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		return "cancelled"
+	case errors.Is(err, document.ErrUnsupported):
+		return "unsupported"
+	case errors.Is(err, document.ErrLocked):
+		return "locked"
+	case errors.Is(err, document.ErrLimit):
+		return "limit"
+	case errors.Is(err, document.ErrInvalid):
+		return "invalid_document"
+	case errors.Is(err, document.ErrUnavailable):
+		return "unavailable"
+	default:
+		return fallback
+	}
+}
+
+func failureKey(failure string) string {
+	switch failure {
+	case "unsupported", "unsupported_document":
+		return "unsupported"
+	case "locked", "locked_document":
+		return "locked"
+	case "limit", "document_resource_limit":
+		return "limit"
+	case "invalid", "invalid_document":
+		return "invalid_document"
+	case "unavailable", "recognition_unavailable":
+		return "unavailable"
+	case "cancelled", "interrupted":
+		return "cancelled"
+	default:
+		return "recognition_failed"
+	}
+}
diff --git a/internal/desktop/desktop_test.go b/internal/desktop/desktop_test.go
