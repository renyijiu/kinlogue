+//go:build darwin
+
+// Package macos is the bounded adapter to public Apple document APIs. Native
+// objects never escape a serialized, locked-thread autorelease-pool lifetime.
+package macos
+
+import (
+	"context"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"github.com/ebitengine/purego"
+	"github.com/ebitengine/purego/objc"
+	"kinlogue/internal/document"
+)
+
+type id = objc.ID
+type point struct{ X, Y float64 }
+type size struct{ Width, Height float64 }
+type rect struct {
+	Origin point
+	Size   size
+}
+type affine struct{ A, B, C, D, TX, TY float64 }
+type nsRange struct{ Location, Length uintptr }
+
+var nativeMu sync.Mutex
+var loadOnce sync.Once
+var loadErr error
+var msgAddr uintptr
+var poolPush func() uintptr
+var poolPop func(uintptr)
+var msgRect func(id, objc.SEL) rect
+var msgRectArg func(id, objc.SEL, uintptr) rect
+var msgRange func(id, objc.SEL, nsRange) id
+var msgConfidence func(id, objc.SEL) float32
+var cfRelease func(uintptr)
+var sourceCreate func(id, id) uintptr
+var sourceCount func(uintptr) uintptr
+var sourceType func(uintptr) id
+var sourceProperties func(uintptr, uintptr, id) id
+var sourceThumbnail func(uintptr, uintptr, id) uintptr
+var imageWidth, imageHeight func(uintptr) uintptr
+var imageRelease func(uintptr)
+var colorSpaceCreate func() uintptr
+var colorSpaceRelease func(uintptr)
+var bitmapCreate func(uintptr, uintptr, uintptr, uintptr, uintptr, uintptr, uint32) uintptr
+var bitmapImage func(uintptr) uintptr
+var bitmapData func(uintptr) uintptr
+var contextRelease func(uintptr)
+var contextFillColor func(uintptr, float64, float64, float64, float64)
+var contextFillRect func(uintptr, rect)
+var contextDrawImage func(uintptr, rect, uintptr)
+var contextConcat func(uintptr, affine)
+var pdfRotation func(uintptr) int32
+var imageKeys = map[string]id{}
+
+// Load only fixed system frameworks. Errors deliberately omit loader diagnostics.
+func load() error {
+	loadOnce.Do(func() {
+		libs := make(map[string]uintptr)
+		for _, name := range []string{"Foundation", "CoreFoundation", "CoreGraphics", "ImageIO", "PDFKit", "Vision"} {
+			h, err := purego.Dlopen("/System/Library/Frameworks/"+name+".framework/"+name, purego.RTLD_NOW|purego.RTLD_GLOBAL)
+			if err != nil {
+				loadErr = document.ErrUnavailable
+				return
+			}
+			libs[name] = h
+		}
+		objcLib, err := purego.Dlopen("/usr/lib/libobjc.A.dylib", purego.RTLD_NOW|purego.RTLD_GLOBAL)
+		if err != nil {
+			loadErr = document.ErrUnavailable
+			return
+		}
+		bind := func(fn any, lib uintptr, name string) {
+			if loadErr != nil {
+				return
+			}
+			p, err := purego.Dlsym(lib, name)
+			if err != nil {
+				loadErr = document.ErrUnavailable
+				return
+			}
+			purego.RegisterFunc(fn, p)
+		}
+		msgAddr, err = purego.Dlsym(objcLib, "objc_msgSend")
+		if err != nil {
+			loadErr = document.ErrUnavailable
+			return
+		}
+		stret := msgAddr
+		if runtime.GOARCH == "amd64" {
+			stret, err = purego.Dlsym(objcLib, "objc_msgSend_stret")
+			if err != nil {
+				loadErr = document.ErrUnavailable
+				return
+			}
+		}
+		purego.RegisterFunc(&msgRect, stret)
+		purego.RegisterFunc(&msgRectArg, stret)
+		purego.RegisterFunc(&msgRange, msgAddr)
+		purego.RegisterFunc(&msgConfidence, msgAddr)
+		bind(&poolPush, objcLib, "objc_autoreleasePoolPush")
+		bind(&poolPop, objcLib, "objc_autoreleasePoolPop")
+		bind(&cfRelease, libs["CoreFoundation"], "CFRelease")
+		bind(&sourceCreate, libs["ImageIO"], "CGImageSourceCreateWithData")
+		bind(&sourceCount, libs["ImageIO"], "CGImageSourceGetCount")
+		bind(&sourceType, libs["ImageIO"], "CGImageSourceGetType")
+		bind(&sourceProperties, libs["ImageIO"], "CGImageSourceCopyPropertiesAtIndex")
+		bind(&sourceThumbnail, libs["ImageIO"], "CGImageSourceCreateThumbnailAtIndex")
+		for _, name := range []string{"kCGImageSourceShouldCache", "kCGImageSourceShouldCacheImmediately", "kCGImageSourceCreateThumbnailFromImageAlways", "kCGImageSourceCreateThumbnailWithTransform", "kCGImageSourceThumbnailMaxPixelSize", "kCGImagePropertyPixelWidth", "kCGImagePropertyPixelHeight"} {
+			p, err := purego.Dlsym(libs["ImageIO"], name)
+			if err != nil {
+				loadErr = document.ErrUnavailable
+				return
+			}
+			imageKeys[name] = **(**id)(unsafe.Pointer(&p))
+		}
+		cg := libs["CoreGraphics"]
+		bind(&imageWidth, cg, "CGImageGetWidth")
+		bind(&imageHeight, cg, "CGImageGetHeight")
+		bind(&imageRelease, cg, "CGImageRelease")
+		bind(&colorSpaceCreate, cg, "CGColorSpaceCreateDeviceRGB")
+		bind(&colorSpaceRelease, cg, "CGColorSpaceRelease")
+		bind(&bitmapCreate, cg, "CGBitmapContextCreate")
+		bind(&bitmapImage, cg, "CGBitmapContextCreateImage")
+		bind(&bitmapData, cg, "CGBitmapContextGetData")
+		bind(&contextRelease, cg, "CGContextRelease")
+		bind(&contextFillColor, cg, "CGContextSetRGBFillColor")
+		bind(&contextFillRect, cg, "CGContextFillRect")
+		bind(&contextConcat, cg, "CGContextConcatCTM")
+		bind(&contextDrawImage, cg, "CGContextDrawImage")
+		bind(&pdfRotation, cg, "CGPDFPageGetRotationAngle")
+	})
+	return loadErr
+}
+
+func native(ctx context.Context, fn func() error) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	nativeMu.Lock()
+	defer nativeMu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if err := load(); err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	pool := poolPush()
+	defer poolPop(pool)
+	err := fn()
+	// Synchronous Apple calls cannot be forcibly interrupted; discard late output.
+	if canceled := ctx.Err(); canceled != nil {
+		return canceled
+	}
+	return err
+}
+
+//go:uintptrescapes
+func send(obj id, selector string, args ...uintptr) id {
+	a := make([]uintptr, len(args)+2)
+	a[0], a[1] = uintptr(obj), uintptr(objc.RegisterName(selector))
+	copy(a[2:], args)
+	r, _, _ := purego.SyscallN(msgAddr, a...)
+	return id(r)
+}
+func class(name string) id { return id(objc.GetClass(name)) }
+func release(obj id) {
+	if obj != 0 {
+		send(obj, "release")
+	}
+}
+func alloc(name string) id { return send(class(name), "alloc") }
+func nsString(s string) id {
+	obj := send(alloc("NSString"), "initWithBytes:length:encoding:", uintptr(unsafe.Pointer(unsafe.StringData(s))), uintptr(len(s)), 4)
+	runtime.KeepAlive(s)
+	return send(obj, "autorelease")
+}
+func nsData(b []byte) id {
+	obj := send(class("NSData"), "dataWithBytes:length:", uintptr(unsafe.Pointer(unsafe.SliceData(b))), uintptr(len(b)))
+	runtime.KeepAlive(b)
+	return obj
+}
+func stringCopy(obj id, limit int) (string, error) {
+	if obj == 0 {
+		return "", nil
+	}
+	n := uint64(send(obj, "lengthOfBytesUsingEncoding:", 4))
+	if n > uint64(limit) {
+		return "", document.ErrLimit
+	}
+	if n == 0 {
+		return "", nil
+	}
+	p := send(obj, "UTF8String")
+	if p == 0 {
+		return "", document.ErrInvalid
+	}
+	return string(unsafe.Slice(*(**byte)(unsafe.Pointer(&p)), int(n))), nil
+}
+func nsArray(objects ...id) id {
+	a := send(class("NSMutableArray"), "arrayWithCapacity:", uintptr(len(objects)))
+	for _, obj := range objects {
+		send(a, "addObject:", uintptr(obj))
+	}
+	return a
+}
+func nsDict(entries map[string]id) id {
+	d := send(class("NSMutableDictionary"), "dictionaryWithCapacity:", uintptr(len(entries)))
+	for key, value := range entries {
+		send(d, "setObject:forKey:", uintptr(value), uintptr(nsString(key)))
+	}
+	return d
+}
+func number(value int) id { return send(class("NSNumber"), "numberWithInteger:", uintptr(value)) }
+func imageOptions(entries map[string]int) id {
+	d := send(class("NSMutableDictionary"), "dictionaryWithCapacity:", uintptr(len(entries)))
+	for key, value := range entries {
+		v := number(value)
+		if key != "kCGImageSourceThumbnailMaxPixelSize" {
+			v = send(class("NSNumber"), "numberWithBool:", uintptr(value))
+		}
+		send(d, "setObject:forKey:", uintptr(v), uintptr(imageKeys[key]))
+	}
+	return d
+}
diff --git a/internal/macos/files_darwin.go b/internal/macos/files_darwin.go
new file mode 100644
index 0000000..0c4e551
--- /dev/null
+++ b/internal/macos/files_darwin.go
@@ -0,0 +1,190 @@
+//go:build darwin
+
+package macos
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	"github.com/ebitengine/purego/objc"
+	"kinlogue/internal/document"
+)
+
+var ErrIdentity = errors.New("untrusted_application_identity")
+var ErrRead = errors.New("import_read_failed")
+
+// LibraryRoot accepts only the separately packaged preview identity, then asks
+// Foundation for the sandbox-aware Application Support URL. There is no HOME,
+// current-directory, command-line or environment override of this root.
+func LibraryRoot() (string, error) {
+	var root string
+	err := native(context.Background(), func() error {
+		bundle := send(class("NSBundle"), "mainBundle")
+		identity, err := stringCopy(send(bundle, "bundleIdentifier"), 256)
+		if err != nil || identity != "com.kinlogue.mac.gopreview" {
+			return ErrIdentity
+		}
+		manager := send(class("NSFileManager"), "defaultManager")
+		var nsError id
+		url := send(manager, "URLForDirectory:inDomain:appropriateForURL:create:error:", 14, 1, 0, 1, uintptr(unsafe.Pointer(&nsError)))
+		if url == 0 || nsError != 0 {
+			return document.ErrUnavailable
+		}
+		base, err := stringCopy(send(url, "path"), 1<<16)
+		if err != nil || !filepath.IsAbs(base) || filepath.Clean(base) != base {
+			return ErrIdentity
+		}
+		if err := ensurePreviewParent(base); err != nil {
+			return err
+		}
+		for _, component := range []string{"KinlogueGoPreview", "Library"} {
+			url = send(url, "URLByAppendingPathComponent:isDirectory:", uintptr(nsString(component)), 1)
+		}
+		root, err = stringCopy(send(url, "path"), 1<<16)
+		if err != nil || !filepath.IsAbs(root) || filepath.Clean(root) != root {
+			return ErrIdentity
+		}
+		return nil
+	})
+	if err != nil {
+		return "", err
+	}
+	return root, nil
+}
+
+func ensurePreviewParent(base string) error {
+	root, err := os.OpenRoot(base)
+	if err != nil {
+		return document.ErrUnavailable
+	}
+	defer root.Close()
+	if err := root.Mkdir("KinlogueGoPreview", 0700); err != nil && !errors.Is(err, os.ErrExist) {
+		return document.ErrUnavailable
+	}
+	info, err := root.Lstat("KinlogueGoPreview")
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
+		return ErrIdentity
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || stat.Uid != uint32(os.Getuid()) {
+		return ErrIdentity
+	}
+	return nil
+}
+
+// PreferredLanguage resolves the OS preference to one of the preview's two
+// resource catalogs. Failure safely falls back to English.
+func PreferredLanguage() string {
+	language := "en"
+	_ = native(context.Background(), func() error {
+		languages := send(class("NSLocale"), "preferredLanguages")
+		count := min(int(send(languages, "count")), 64)
+		for index := 0; index < count; index++ {
+			candidate, err := stringCopy(send(languages, "objectAtIndex:", uintptr(index)), 128)
+			if err != nil {
+				continue
+			}
+			if strings.HasPrefix(candidate, "zh") {
+				language = "zh-Hans"
+				break
+			}
+			if strings.HasPrefix(candidate, "en") {
+				break
+			}
+		}
+		return nil
+	})
+	return language
+}
+
+// ReadImportedFile scopes and coordinates the copy of a user-selected file.
+// Selection must come from the system open panel; path strings are never used
+// to grant access independently. All errors are stable and content/path-free.
+func ReadImportedFile(path string) ([]byte, error) {
+	if !filepath.IsAbs(path) || strings.IndexByte(path, 0) >= 0 || len(path) > 1<<16 {
+		return nil, ErrRead
+	}
+	var data []byte
+	err := native(context.Background(), func() error {
+		url := send(class("NSURL"), "fileURLWithPath:", uintptr(nsString(path)))
+		if url == 0 {
+			return ErrRead
+		}
+		scoped := byte(send(url, "startAccessingSecurityScopedResource")) != 0
+		if scoped {
+			defer send(url, "stopAccessingSecurityScopedResource")
+		}
+		// Scope covers metadata and the copy. Reject special files before asking
+		// file coordination to wait, then recheck the actual descriptor below.
+		info, err := os.Lstat(path)
+		if err != nil || !info.Mode().IsRegular() {
+			return ErrRead
+		}
+		if info.Size() > document.MaxFileBytes {
+			return document.ErrLimit
+		}
+		// A false scope result is also normal for already-accessible files and
+		// tests. The actual read remains subject to macOS sandbox enforcement.
+		coordinator := send(alloc("NSFileCoordinator"), "initWithFilePresenter:", 0)
+		if coordinator == 0 {
+			return ErrRead
+		}
+		defer release(coordinator)
+		var nsError id
+		var readErr error = ErrRead
+		accessor := objc.NewBlock(func(_ objc.Block, coordinatedURL id) {
+			coordinatedPath, e := stringCopy(send(coordinatedURL, "path"), 1<<16)
+			if e != nil {
+				readErr = ErrRead
+				return
+			}
+			data, readErr = readRegular(coordinatedPath)
+		})
+		defer accessor.Release()
+		// ReadingWithoutChanges; never ResolvesSymbolicLink. O_NOFOLLOW remains
+		// authoritative after any rename race during coordination.
+		send(coordinator, "coordinateReadingItemAtURL:options:error:byAccessor:", uintptr(url), 1, uintptr(unsafe.Pointer(&nsError)), uintptr(accessor))
+		if nsError != 0 {
+			return ErrRead
+		}
+		return readErr
+	})
+	if err != nil {
+		return nil, err
+	}
+	return data, nil
+}
+
+func readRegular(path string) ([]byte, error) {
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_CLOEXEC|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, ErrRead
+	}
+	file := os.NewFile(uintptr(fd), "")
+	defer file.Close()
+	before, err := file.Stat()
+	if err != nil || !before.Mode().IsRegular() {
+		return nil, ErrRead
+	}
+	if before.Size() > document.MaxFileBytes {
+		return nil, document.ErrLimit
+	}
+	data, err := io.ReadAll(io.LimitReader(file, document.MaxFileBytes+1))
+	if err != nil {
+		return nil, ErrRead
+	}
+	if len(data) > document.MaxFileBytes {
+		return nil, document.ErrLimit
+	}
+	after, err := file.Stat()
+	if err != nil || after.Size() != before.Size() || after.ModTime() != before.ModTime() || int64(len(data)) != after.Size() {
+		return nil, ErrRead
+	}
+	return data, nil
+}
