+	"locked":             {"PDF 已加密或锁定，请先提供可读取的副本。", "The PDF is encrypted or locked. Provide a readable copy."},
+	"limit":              {"文件超出安全处理上限，请减少页数或图片尺寸。", "The file exceeds processing limits. Reduce its pages or image dimensions."},
+	"invalid_document":   {"文件损坏或无法读取，请重新导出原件。", "The file is damaged or unreadable. Export the original again."},
+	"unavailable":        {"本机识别暂时不可用，可以稍后重试。", "On-device recognition is unavailable. Try again later."},
+	"recognition_failed": {"无法完成识别。原件仍在草稿中，可以重试或删除。", "Recognition could not finish. The original remains in this draft; retry or delete it."},
+	"raw_ocr":            {"查看初始识别", "Show initial recognition"},
+	"raw_hint":           {"初始识别只用于核对；搜索使用已确认的修正转录。", "Initial recognition is reference only. Search uses your confirmed correction."},
+	"source_page":        {"来源第 %d 页", "Source page %d"},
+	"file_menu":          {"文件", "File"},
+	"edit_menu":          {"编辑", "Edit"},
+	"undo":               {"撤销", "Undo"},
+	"redo":               {"重做", "Redo"},
+	"cut":                {"剪切", "Cut"},
+	"copy":               {"复制", "Copy"},
+	"paste":              {"粘贴", "Paste"},
+	"select_all":         {"全选", "Select All"},
+	"quit":               {"退出续页预览版", "Quit Kinlogue Preview"},
+}
+
+func translate(language, key string, args ...any) string {
+	index := 0
+	if language == "en" {
+		index = 1
+	}
+	value, ok := stringsTable[key]
+	if !ok {
+		panic("desktop: missing translation key " + key)
+	}
+	if len(args) == 0 {
+		return value[index]
+	}
+	return fmt.Sprintf(value[index], args...)
+}
diff --git a/internal/desktop/view.go b/internal/desktop/view.go
new file mode 100644
index 0000000..571dcef
