<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ · %@ · %lld 轮</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%3$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ · %2$@ · %3$lld turn</string>
			<key>other</key>
			<string>%1$@ · %2$@ · %3$lld turns</string>
		</dict>
	</dict>
	<key>%lld 个唯一原件 · 原件内容 %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Unique original: %1$lld · Source content: %2$@</string>
			<key>other</key>
			<string>Unique originals: %1$lld · Source content: %2$@</string>
		</dict>
	</dict>
	<key>%lld 个唯一原件 · 实际占用 %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Unique original: %1$lld · Disk usage: %2$@</string>
			<key>other</key>
			<string>Unique originals: %1$lld · Disk usage: %2$@</string>
		</dict>
	</dict>
	<key>%lld 个文件</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld file</string>
			<key>other</key>
			<string>%lld files</string>
		</dict>
	</dict>
	<key>%lld 个项目</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>%lld 份报告</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld report</string>
			<key>other</key>
			<string>%lld reports</string>
		</dict>
	</dict>
	<key>%lld 份报告无法读取，没有包含在内</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld report could not be read and is left out</string>
			<key>other</key>
			<string>%lld reports could not be read and are left out</string>
		</dict>
	</dict>
	<key>%lld 份报告过长，只发送开头部分</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld report is too long; only its beginning is sent</string>
			<key>other</key>
			<string>%lld reports are too long; only their beginnings are sent</string>
		</dict>
	</dict>
	<key>%lld 行</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld row</string>
			<key>other</key>
			<string>%lld rows</string>
		</dict>
	</dict>
	<key>共 %lld 个原件；顺序只影响这次报告。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld original; the order only affects this report.</string>
			<key>other</key>
			<string>%lld originals; the order only affects this report.</string>
		</dict>
	</dict>
	<key>共 %lld 个文件，%@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld file, %2$@</string>
			<key>other</key>
			<string>%1$lld files, %2$@</string>
		</dict>
	</dict>
	<key>另有 %lld 个检验项目没有列入</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld more item is not listed</string>
			<key>other</key>
			<string>%lld more items are not listed</string>
		</dict>
	</dict>
	<key>另有 %lld 份较早报告的结论没有列入</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld older report's conclusion is not listed</string>
			<key>other</key>
			<string>%lld older reports' conclusions are not listed</string>
		</dict>
	</dict>
	<key>另有 %lld 份较早的报告不会发送</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld older report will not be sent</string>
			<key>other</key>
			<string>%lld older reports will not be sent</string>
		</dict>
	</dict>
	<key>另有 %lld 条较早的检验结果没有列入</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld older result row is not listed</string>
			<key>other</key>
			<string>%lld older result rows are not listed</string>
		</dict>
	</dict>
	<key>已选 %lld 个原件，作为 1 份报告</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld original selected as one report</string>
			<key>other</key>
			<string>%lld originals selected as one report</string>
		</dict>
	</dict>
	<key>正在等待 Codex 回答 · %lld 秒</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Waiting for Codex to answer · %lld second</string>
			<key>other</key>
			<string>Waiting for Codex to answer · %lld seconds</string>
		</dict>
	</dict>
	<key>还有 %lld 行匹配</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld more matching line</string>
			<key>other</key>
			<string>%lld more matching lines</string>
		</dict>
	</dict>
</dict>
</plist>
