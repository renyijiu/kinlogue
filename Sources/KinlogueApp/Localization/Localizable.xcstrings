    "查看并确认…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and Confirm…"
          }
        }
      }
    },
    "确认后，续页会把这位成员 %@的转录文本和你的问题发送给 Codex。确认前可以查看将要发送的全部内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
